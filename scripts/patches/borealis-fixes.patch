+float ScrollingFrame::effectiveScrollHeight()
+{
+    float h = this->getScrollingAreaHeight() - this->bottomSafeInset;
+    // Guard against a tiny frame fully covered by the inset.
+    return h > 0.0f ? h : this->getScrollingAreaHeight();
