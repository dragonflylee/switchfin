+void Application::onViewDestroyed(View* view)
+{
+    // The view is in its destructor: do NOT call any virtual method or fire
+    // any event on it, just forget every reference we may still hold.
+    // Note that giveFocus(nullptr) cannot be used here: it is a no-op by
+    // design (it refuses to clear the current focus), which would leave
+    // Application::currentFocus dangling and crash on the next giveFocus
+    // (oldFocus->onFocusLost() on freed memory).
+    if (Application::currentFocus == view)
+    {
+        Application::currentFocus = nullptr;
+
+        // With a null focus, button navigation is permanently dead
+        // (navigate() no-ops) while touch keeps working — on a docked Switch
+        // (no touchscreen) the app is stuck. Schedule a fallback refocus on
+        // the next iteration, once whatever destroyed this view (typically a
+        // content refresh) is done, and only if the focus is still orphaned.
+        sync([]() {
+            if (!Application::currentFocus && !Application::activitiesStack.empty())
+                Application::giveFocus(Application::activitiesStack[Application::activitiesStack.size() - 1]->getDefaultFocus());
+        });
+    }
+
+    if (Application::repetitionOldFocus == view)
+        Application::repetitionOldFocus = nullptr;
+
+    // The focus stack (pushActivity/popActivity) also holds raw pointers that
+    // popActivity would dereference to restore focus.
+    Application::focusStack.erase(
+        std::remove(Application::focusStack.begin(), Application::focusStack.end(), view),
+        Application::focusStack.end());
+
+    Application::tryDeinitFirstResponder(view);
+}
