+
+void ScrollingFrame::refreshBottomSafeInset()
+{
+    // Auto-detect a floating footer overlay: find an ancestor AppletFrame and,
+    // if its footer is visible and overlaps our bottom edge, reserve that much
+    // height in the SCROLL MATH (not the visual scissor) so a focused/last item
+    // never rests hidden under the footer. No overlap (dialogs, popups, short
+    // frames whose bottom is above the footer) -> inset stays 0.
+    float inset       = 0.0f;
+    bool foundFrame   = false;
+    bool footerVis    = false;
+    float footerY     = -1.0f;
+    for (Box* p = this->getParent(); p != nullptr; p = p->getParent())
+    {
+        if (AppletFrame* af = dynamic_cast<AppletFrame*>(p))
+        {
+            foundFrame  = true;
+            Box* footer = af->getFooter();
+            if (footer && footer->getVisibility() == Visibility::VISIBLE)
+            {
+                footerVis     = true;
+                footerY       = footer->getY();
+                float overlap = (this->getY() + this->getScrollingAreaHeight()) - footerY;
+                if (overlap > 0.0f)
+                    inset = overlap;
+            }
+            break;
+        }
+    }
+    if (inset != this->bottomSafeInset)
+        Logger::error("[INSET] {} -> {} (frame={} footerVis={} thisY={} saH={} footerY={})",
+            this->bottomSafeInset, inset, foundFrame, footerVis, this->getY(), this->getScrollingAreaHeight(), footerY);
+    this->bottomSafeInset = inset;
+}
