+bool RecyclerFrame::checkSize()
+{
+    // Trigger a reload whenever the viewport width OR height changes. Height
+    // matters because the set of cached/visible cells is sized against the
+    // viewport: a frame whose height is still growing toward its final value
+    // (e.g. Dropdown fixes its content height only after setDataSource has
+    // already reloaded once) would otherwise keep the cell set computed for the
+    // stale, smaller viewport and leave the last rows unreachable. oldWidth /
+    // oldHeight are per-instance (a former function-static shared them across
+    // every recycler, so only the first one to lay out ever reloaded).
+    float width  = getWidth();
+    float height = getHeight();
+    bool changed = ((int)oldWidth != (int)width || (int)oldHeight != (int)height) && width != 0 && height != 0;
+    oldWidth  = width;
+    oldHeight = height;
+    return changed;
 }
 
