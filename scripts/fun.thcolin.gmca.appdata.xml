    <summary>Controller-first media client for Plex, Jellyfin, Emby and Stremio</summary>
    <launchable type="desktop-id">fun.thcolin.gmca.desktop</launchable>
    <translation type="gettext">gmca</translation>
    <content_rating type="oars-1.1">
