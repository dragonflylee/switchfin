# Maintainer:  Dave Murphy <davem@devkitpro.org>
# Contributor: Julian Uy <uyjulian@gmail.com>

pkgname=switch-mupdf
pkgver=1.28.6
pkgrel=1
pkgdesc='MuPDF is a lightweight PDF, XPS, and E-book viewer.'
arch=('any')
url='https://mupdf.com/'
license=('AGPL')
options=(!strip libtool staticlibs)
depends=("switch-freetype" "switch-harfbuzz" "switch-libjpeg-turbo" "switch-zlib")
makedepends=('switch-pkg-config' 'dkp-toolchain-vars')
source=("https://casper.mupdf.com/downloads/archive/mupdf-$pkgver-source.tar.lz" "mupdf.patch")
groups=('switch-portlibs')
sha256sums=('f675f2456916d720cc3108c4a6a9de6467ee0665dbca440cd62a382a75be917e' 'SKIP')

build() {
  cd mupdf-$pkgver-source

  patch -Np1 -i "$srcdir/mupdf.patch"

  source ${DEVKITPRO}/switchvars.sh

  make build=release OS=switch libs -j$(nproc)
}

package() {
  cd mupdf-$pkgver-source
  make build=release \
    prefix="${PORTLIBS_PREFIX}" DESTDIR="$pkgdir" \
    OS=switch install-libs
}