
# Maintainer: WinterMute <davem@devkitpro.org>
pkgname=switch-curl
pkgver=8.23.0
pkgrel=3
pkgdesc='An URL retrieval utility and library'
arch=('any')
url="https://curl.se/"
license=('zlib')
options=(!strip libtool staticlibs)
depends=('switch-zlib')
makedepends=('switch-pkg-config' 'dkp-toolchain-vars')
source=("https://curl.se/download/curl-${pkgver}.tar.xz" "tls.patch")
groups=('switch-portlibs')

sha256sums=('8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5' 'SKIP')

prepare() {
  cd curl-$pkgver
  patch -Np1 -i "$srcdir/tls.patch"
}

build() {
  cd curl-$pkgver

  source ${DEVKITPRO}/switchvars.sh
  LDFLAGS="-specs=${DEVKITPRO}/libnx/switch.specs ${LDFLAGS}"

  autoreconf -fi

  ./configure --prefix=$PORTLIBS_PREFIX --host=aarch64-none-elf \
    --disable-shared --enable-static --disable-ipv6 --disable-unix-sockets \
    --disable-manual --disable-threaded-resolver --disable-progress-meter \
    --without-zstd --without-brotli --without-libpsl --enable-websockets \
    --with-libnx --with-default-ssl-backend=libnx
  sed -i '/HAVE_SOCKETPAIR/d' lib/curl_config.h
  make -C lib -j$(nproc)
}

package() {
  cd curl-$pkgver

  source ${DEVKITPRO}/switchvars.sh

  make DESTDIR="$pkgdir" -C lib install
  make DESTDIR="$pkgdir" -C include install
  make DESTDIR="$pkgdir" install-binSCRIPTS install-pkgconfigDATA
}
