
# Maintainer: WinterMute <davem@devkitpro.org>
pkgname=switch-curl
pkgver=8.13.0
pkgrel=1
pkgdesc='An URL retrieval utility and library'
arch=('any')
url="https://curl.se/"
license=('zlib')
options=(!strip libtool staticlibs)
depends=('switch-zlib' 'switch-mbedtls')
makedepends=('switch-pkg-config' 'dkp-toolchain-vars')
source=("https://curl.haxx.se/download/curl-${pkgver}.tar.xz")
groups=('switch-portlibs')

sha256sums=('4a093979a3c2d02de2fbc00549a32771007f2e78032c6faa5ecd2f7a9e152025')

build() {
  cd curl-${pkgver}

  source ${DEVKITPRO}/switchvars.sh

  aarch64-none-elf-cmake \
    -DCMAKE_INSTALL_PREFIX=$PORTLIBS_PREFIX \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_CURL_EXE=OFF \
    -DBUILD_SHARED_LIBS=OFF \
    -DBUILD_TESTING=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_LIBCURL_DOCS=OFF \
    -DBUILD_MISC_DOCS=OFF \
    -DENABLE_CURL_MANUAL=OFF \
    -DHTTP_ONLY=ON \
    -DCURL_USE_MBEDTLS=ON \
    -DCURL_DISABLE_PROGRESS_METER=ON \
    -DCURL_DISABLE_SOCKETPAIR=ON \
    -DCURL_DISABLE_MIME=ON \
    -DENABLE_IPV6=OFF \
    -DENABLE_THREADED_RESOLVER=OFF \
    -DUSE_NGHTTP2=OFF \
    -DUSE_LIBIDN2=OFF \
    -DCURL_BROTLI=OFF \
    -DCURL_ZSTD=OFF \
    -DCURL_USE_LIBSSH2=OFF \
    -DCURL_USE_LIBPSL=OFF \
    .
  sed -i '/HAVE_SOCKETPAIR/d' lib/curl_config.h
  make -j$(nproc)
}

package() {
  cd curl-${pkgver}
  make install DESTDIR="$pkgdir"
}