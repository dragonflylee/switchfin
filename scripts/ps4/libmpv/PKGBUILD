# Maintainer:  cpasjuste <cpasjuste@gmail.com>

pkgname=ps4-openorbis-libmpv
pkgver=0.36.0
pkgrel=4
pkgdesc='Command line video player (library only)'
arch=('any')
url='https://mpv.io/'
license=('GPL')
options=(!strip !debug libtool staticlibs)
source=("libmpv-${pkgver}.tar.gz::https://github.com/mpv-player/mpv/archive/v${pkgver}.tar.gz" 'mpv.patch' 'cross.txt')
sha256sums=('29abc44f8ebee013bb2f9fe14d80b30db19b534c679056e4851ceadf5a5e8bf6' 'SKIP' 'SKIP')
makedepends=('ps4-openorbis-pkg-config' 'ps4-openorbis-vars')
depends=('ps4-openorbis-sdl2' 'ps4-openorbis-ffmpeg' 'ps4-openorbis-libass')
groups=('ps4-openorbis-portlibs')

prepare() {
  cd mpv-$pkgver
  patch -Np1 -i "$srcdir/mpv.patch"
}

build() {
  source /opt/pacbrew/ps4/openorbis/ps4vars.sh

  meson setup build mpv-${pkgver} \
    --buildtype=plain --cross-file=cross.txt \
    --default-library=static --libdir=lib \
    --prefix="${OPENORBIS}/usr" \
    -Dcplayer=false -Dlibmpv=true \
    -Diconv=disabled -Djpeg=disabled -Dlibavdevice=disabled \
    -Dsdl2=enabled -Dsdl2-audio=enabled -Dsdl2-gamepad=disabled -Dsdl2-video=disabled

  meson compile -C build
}

package() {
  meson install -C build --destdir "${pkgdir}"
}

