+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <libssh2.h>
+#include <libssh2_sftp.h>
+
+#include "libavutil/avstring.h"
+#include "libavutil/attributes.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/thread.h"
+#include "libavformat/avio.h"
+#include "avformat.h"
+#include "internal.h"
+#include "url.h"
+
+typedef struct LIBSSHContext {
+    const AVClass *class;
+    URLContext *tcp;
+    LIBSSH2_SESSION *session;
+    LIBSSH2_SFTP *sftp;
+    LIBSSH2_SFTP_HANDLE *file;
+    int64_t filesize;
+    int rw_timeout;
+    int trunc;
+    char *priv_key;
+} LIBSSHContext;
+
+/* libssh2_init() is process wide: call it once, never call libssh2_exit() */
+static AVOnce libssh2_once = AV_ONCE_INIT;
+static int libssh2_init_status;
+
+static void libssh2_do_init(void)
+{
+    libssh2_init_status = libssh2_init(0);
+}
+
+static int ssh2_error(LIBSSHContext *libssh2, int error)
+{
+    if (error == LIBSSH2_ERROR_SFTP_PROTOCOL && libssh2->sftp) {
+        switch (libssh2_sftp_last_error(libssh2->sftp)) {
+        case LIBSSH2_FX_NO_SUCH_FILE:
+        case LIBSSH2_FX_NO_SUCH_PATH:
+            return AVERROR(ENOENT);
+        case LIBSSH2_FX_PERMISSION_DENIED:
+        case LIBSSH2_FX_WRITE_PROTECT:
+            return AVERROR(EACCES);
+        default:
+            return AVERROR(EIO);
+        }
+    }
+
+    switch (error) {
+    case LIBSSH2_ERROR_ALLOC:
+        return AVERROR(ENOMEM);
+#ifdef LIBSSH2_ERROR_TIMEOUT
+    case LIBSSH2_ERROR_TIMEOUT:
+#endif
+    case LIBSSH2_ERROR_SOCKET_TIMEOUT:
+        return AVERROR(ETIMEDOUT);
+    case LIBSSH2_ERROR_AUTHENTICATION_FAILED:
+        return AVERROR(EACCES);
+    default:
+        return AVERROR(EIO);
+    }
+}
+
+static int ssh2_fail(LIBSSHContext *libssh2, int error, const char *what)
+{
+    char *msg = NULL;
+
+    libssh2_session_last_error(libssh2->session, &msg, NULL, 0);
+    av_log(libssh2, AV_LOG_ERROR, "%s: %s\n", what, msg ? msg : "unknown error");
+    return ssh2_error(libssh2, error);
+}
+
+static av_cold int libssh2_create_ssh_session(URLContext *h, const char *hostname, int port)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    AVDictionary *opts = NULL;
+    char buf[1100];
+    int fd, ret;
+
+    ff_thread_once(&libssh2_once, libssh2_do_init);
+    if (libssh2_init_status) {
+        av_log(libssh2, AV_LOG_ERROR, "Unable to initialize libssh2.\n");
+        return AVERROR(EIO);
+    }
+
+    if (libssh2->rw_timeout > 0) {
+        char timeout[32];
+        snprintf(timeout, sizeof(timeout), "%d", libssh2->rw_timeout * 1000);
+        av_dict_set(&opts, "rw_timeout", timeout, 0);
+    }
+    ff_url_join(buf, sizeof(buf), "tcp", NULL, hostname, port, NULL);
+    ret = ffurl_open_whitelist(&libssh2->tcp, buf, AVIO_FLAG_READ_WRITE,
+                               &h->interrupt_callback, &opts,
+                               h->protocol_whitelist, h->protocol_blacklist, h);
+    av_dict_free(&opts);
+    if (ret < 0)
+        return ret;
+
+    fd = ffurl_get_file_handle(libssh2->tcp);
+    if (fd < 0) {
+        av_log(libssh2, AV_LOG_ERROR, "Unable to get connection handle.\n");
+        return AVERROR(EIO);
+    }
+
+    if (!(libssh2->session = libssh2_session_init())) {
+        av_log(libssh2, AV_LOG_ERROR, "SSH session creation failed.\n");
+        return AVERROR(ENOMEM);
+    }
+    if (libssh2->rw_timeout > 0)
+        libssh2_session_set_timeout(libssh2->session, libssh2->rw_timeout);
+
+    if ((ret = libssh2_session_handshake(libssh2->session, fd)))
+        return ssh2_fail(libssh2, ret, "Failure establishing SSH session");
+
+    return 0;
+}
+
+static av_cold int libssh2_authentication(LIBSSHContext *libssh2, const char *user, const char *password)
+{
+    int ret;
+
+    if (!user || !*user) {
+        av_log(libssh2, AV_LOG_ERROR, "No username given, use sftp://user@host/path\n");
+        return AVERROR(EINVAL);
+    }
+
+    if (libssh2->priv_key) {
+        ret = libssh2_userauth_publickey_fromfile(libssh2->session, user, NULL,
+                                                  libssh2->priv_key, password);
+        if (!ret)
+            return 0;
+        av_log(libssh2, AV_LOG_DEBUG, "Authentication with selected private key failed.\n");
+    }
+
+    if (password) {
+        ret = libssh2_userauth_password(libssh2->session, user, password);
+        if (!ret && libssh2_userauth_authenticated(libssh2->session))
+            return 0;
+        av_log(libssh2, AV_LOG_ERROR, "Authentication failed.\n");
+    }
+
+    return AVERROR(EACCES);
+}
+
+static av_cold int libssh2_create_sftp_session(LIBSSHContext *libssh2)
+{
+    if (!(libssh2->sftp = libssh2_sftp_init(libssh2->session)))
+        return ssh2_fail(libssh2, libssh2_session_last_errno(libssh2->session),
+                         "SFTP session creation failed");
+
+    return 0;
+}
+
+static av_cold int libssh2_open_file(LIBSSHContext *libssh2, int flags, const char *file)
+{
+    unsigned long access;
+
+    if ((flags & AVIO_FLAG_WRITE) && (flags & AVIO_FLAG_READ)) {
+        access = LIBSSH2_FXF_CREAT | LIBSSH2_FXF_READ | LIBSSH2_FXF_WRITE;
+        if (libssh2->trunc)
+            access |= LIBSSH2_FXF_TRUNC;
+    } else if (flags & AVIO_FLAG_WRITE) {
+        access = LIBSSH2_FXF_CREAT | LIBSSH2_FXF_WRITE;
+        if (libssh2->trunc)
+            access |= LIBSSH2_FXF_TRUNC;
+    } else
+        access = LIBSSH2_FXF_READ;
+
+    /* 0666 = -rw-rw-rw- = read+write for everyone, minus umask */
+    if (!(libssh2->file = libssh2_sftp_open(libssh2->sftp, file, access, 0666)))
+        return ssh2_fail(libssh2, libssh2_session_last_errno(libssh2->session),
+                         "Error opening sftp file");
+
+    return 0;
+}
+
+static av_cold void libssh2_stat_file(LIBSSHContext *libssh2)
+{
+    LIBSSH2_SFTP_ATTRIBUTES attr;
+
+    if (libssh2_sftp_fstat_ex(libssh2->file, &attr, 0) ||
+        !(attr.flags & LIBSSH2_SFTP_ATTR_SIZE)) {
+        av_log(libssh2, AV_LOG_WARNING, "Cannot stat remote file.\n");
+        libssh2->filesize = -1;
+    } else {
+        libssh2->filesize = attr.filesize;
+    }
+}
+
+static av_cold int libssh2_close(URLContext *h)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+
+    if (libssh2->file) {
+        libssh2_sftp_close(libssh2->file);
+        libssh2->file = NULL;
+    }
+    if (libssh2->sftp) {
+        libssh2_sftp_shutdown(libssh2->sftp);
+        libssh2->sftp = NULL;
+    }
+    if (libssh2->session) {
+        libssh2_session_disconnect(libssh2->session, "Normal Shutdown");
+        libssh2_session_free(libssh2->session);
+        libssh2->session = NULL;
+    }
+    ffurl_closep(&libssh2->tcp);
+    return 0;
+}
+
+static av_cold int libssh2_connect(URLContext *h, const char *url, char *path, size_t path_size)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    char proto[10], hostname[1024], credentials[1024];
+    int port = 22, ret;
+    const char *user = NULL, *pass = NULL;
+    char *end = NULL;
+
+    av_url_split(proto, sizeof(proto),
+                 credentials, sizeof(credentials),
+                 hostname, sizeof(hostname),
+                 &port,
+                 path, path_size,
+                 url);
+
+    if (!(*path))
+        av_strlcpy(path, "/", path_size);
+
+    if (port <= 0 || port > 65535)
+        port = 22;
+
+    if ((ret = libssh2_create_ssh_session(h, hostname, port)) < 0)
+        return ret;
+
+    user = av_strtok(credentials, ":", &end);
+    pass = av_strtok(end, ":", &end);
+
+    if ((ret = libssh2_authentication(libssh2, user, pass)) < 0)
+        return ret;
+
+    if ((ret = libssh2_create_sftp_session(libssh2)) < 0)
+        return ret;
+
+    return 0;
+}
+
+static av_cold int libssh2_open(URLContext *h, const char *url, int flags)
+{
+    int ret;
+    LIBSSHContext *libssh2 = h->priv_data;
+    char path[MAX_URL_SIZE];
+
+    if ((ret = libssh2_connect(h, url, path, sizeof(path))) < 0)
+        goto fail;
+
+    if ((ret = libssh2_open_file(libssh2, flags, path)) < 0)
+        goto fail;
+
+    libssh2_stat_file(libssh2);
+
+    return 0;
+
+  fail:
+    libssh2_close(h);
+    return ret;
+}
+
+static int64_t libssh2_seek(URLContext *h, int64_t pos, int whence)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    int64_t newpos;
+
+    if (libssh2->filesize == -1 && (whence == AVSEEK_SIZE || whence == SEEK_END)) {
+        av_log(h, AV_LOG_ERROR, "Error during seeking.\n");
+        return AVERROR(EIO);
+    }
+
+    switch (whence) {
+    case AVSEEK_SIZE:
+        return libssh2->filesize;
+    case SEEK_SET:
+        newpos = pos;
+        break;
+    case SEEK_CUR:
+        newpos = libssh2_sftp_tell64(libssh2->file) + pos;
+        break;
+    case SEEK_END:
+        newpos = libssh2->filesize + pos;
+        break;
+    default:
+        return AVERROR(EINVAL);
+    }
+
+    if (newpos < 0) {
+        av_log(h, AV_LOG_ERROR, "Seeking to negative position.\n");
+        return AVERROR(EINVAL);
+    }
+
+    libssh2_sftp_seek64(libssh2->file, newpos);
+
+    return newpos;
+}
+
+static int libssh2_read(URLContext *h, unsigned char *buf, int size)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    int bytes_read;
+
+    if ((bytes_read = libssh2_sftp_read(libssh2->file, buf, size)) < 0)
+        return ssh2_fail(libssh2, bytes_read, "Read error");
+
+    return bytes_read ? bytes_read : AVERROR_EOF;
+}
+
+static int libssh2_write(URLContext *h, const unsigned char *buf, int size)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    int written = 0;
+
+    while (written < size) {
+        int ret = libssh2_sftp_write(libssh2->file, buf + written, size - written);
+
+        if (ret < 0)
+            return written ? written : ssh2_fail(libssh2, ret, "Write error");
+        if (!ret)
+            return written ? written : AVERROR(EIO);
+        written += ret;
+    }
+
+    return written;
+}
+
+static int libssh2_open_dir(URLContext *h)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    int ret;
+    char path[MAX_URL_SIZE];
+
+    if ((ret = libssh2_connect(h, h->filename, path, sizeof(path))) < 0)
+        goto fail;
+
+    if (!(libssh2->file = libssh2_sftp_opendir(libssh2->sftp, path))) {
+        ret = ssh2_fail(libssh2, libssh2_session_last_errno(libssh2->session),
+                        "Error opening sftp dir");
+        goto fail;
+    }
+
+    return 0;
+
+  fail:
+    libssh2_close(h);
+    return ret;
+}
+
+static int libssh2_read_dir(URLContext *h, AVIODirEntry **next)
+{
+    LIBSSHContext *libssh2 = h->priv_data;
+    LIBSSH2_SFTP_ATTRIBUTES attr;
+    AVIODirEntry *entry;
+    char name[1024];
+    int ret;
+
+    *next = entry = ff_alloc_dir_entry();
+    if (!entry)
+        return AVERROR(ENOMEM);
+
+    do {
+        memset(&attr, 0, sizeof(attr));
+        memset(name, 0, sizeof(name));
+        ret = libssh2_sftp_readdir(libssh2->file, name, sizeof(name), &attr);
+        if (ret <= 0)
+            break;
+    } while (ret >= (int)sizeof(name) || !strcmp(name, ".") || !strcmp(name, ".."));
+
+    if (ret <= 0) {
+        av_freep(next);
+        return ret ? ssh2_fail(libssh2, libssh2_session_last_errno(libssh2->session),
+                               "Error reading sftp dir") : 0;
+    }
+
+    entry->name = av_strdup(name);
+    if (!entry->name) {
+        av_freep(next);
+        return AVERROR(ENOMEM);
+    }
+    entry->group_id = attr.gid;
+    entry->user_id = attr.uid;
+    entry->size = attr.filesize;
+    entry->access_timestamp = INT64_C(1000000) * attr.atime;
+    entry->modification_timestamp = INT64_C(1000000) * attr.mtime;
+    entry->filemode = attr.permissions & 0777;
+    if (LIBSSH2_SFTP_S_ISDIR(attr.permissions))
+        entry->type = AVIO_ENTRY_DIRECTORY;
+    else if (LIBSSH2_SFTP_S_ISREG(attr.permissions))
+        entry->type = AVIO_ENTRY_FILE;
+    else if (LIBSSH2_SFTP_S_ISLNK(attr.permissions))
+        entry->type = AVIO_ENTRY_SYMBOLIC_LINK;
+    else
+        entry->type = AVIO_ENTRY_UNKNOWN;
+    return 0;
+}
+
+#define OFFSET(x) offsetof(LIBSSHContext, x)
+#define D AV_OPT_FLAG_DECODING_PARAM
+#define E AV_OPT_FLAG_ENCODING_PARAM
+static const AVOption options[] = {
+    {"timeout", "set timeout of socket I/O operations", OFFSET(rw_timeout), AV_OPT_TYPE_INT, {.i64 = -1}, -1, INT_MAX, D|E },
+    {"truncate", "Truncate existing files on write", OFFSET(trunc), AV_OPT_TYPE_INT, { .i64 = 1 }, 0, 1, E },
+    {"private_key", "set path to private key", OFFSET(priv_key), AV_OPT_TYPE_STRING, { .str = NULL }, 0, 0, D|E },
+    {NULL}
+};
+
+static const AVClass libssh2_context_class = {
+    .class_name     = "libssh2",
+    .item_name      = av_default_item_name,
+    .option         = options,
+    .version        = LIBAVUTIL_VERSION_INT,
+};
+
+const URLProtocol ff_libssh2_protocol = {
+    .name                = "sftp",
+    .url_open            = libssh2_open,
+    .url_read            = libssh2_read,
+    .url_write           = libssh2_write,
+    .url_seek            = libssh2_seek,
+    .url_close           = libssh2_close,
+    .url_open_dir        = libssh2_open_dir,
+    .url_read_dir        = libssh2_read_dir,
+    .url_close_dir       = libssh2_close,
