 libavformat/Makefile    |   1 +
 libavformat/avformat.h  |   4 +-
 libavformat/avio.h      |  20 +-
 libavformat/libssh2.c   | 455 ++++++++++++++++++++++++++++++++++++++++
 libavformat/protocols.c |   1 +
 6 files changed, 479 insertions(+), 7 deletions(-)
 create mode 100644 libavformat/libssh2.c

