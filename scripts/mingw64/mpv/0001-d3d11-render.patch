 }
+
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
+
+struct priv {
+    pl_log pl_log;
+    pl_opengl gl;
+    pl_gpu gpu;
+    pl_tex wrapped_tex;
+    int wrapped_fbo;
+    int wrapped_w, wrapped_h;
+};
+
+static bool pl_callback_gl(void *priv)
+{
+    mpv_opengl_init_params *gl_params = priv;
+    return gl_params->get_proc_address(gl_params->get_proc_address_ctx,
+                                       "glGetString") != NULL;
+}
+
+static int gl_init(struct libmpv_gpu_next_context *ctx, mpv_render_param *params)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+
+    mpv_opengl_init_params *gl_params =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, NULL);
+    if (!gl_params || !gl_params->get_proc_address)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    p->pl_log = mppl_log_create(ctx, ctx->log);
+    if (!p->pl_log)
+        return MPV_ERROR_VO_INIT_FAILED;
+    mppl_log_set_probing(p->pl_log, false);
+
+    p->gl = pl_opengl_create(p->pl_log, pl_opengl_params(
+        .get_proc_addr_ex = (pl_voidfunc_t (*)(void*, const char*))gl_params->get_proc_address,
+        .proc_ctx = gl_params->get_proc_address_ctx,
+        .make_current = pl_callback_gl,
+        .priv = gl_params
+    ));
+
+    if (!p->gl)
+        return MPV_ERROR_UNSUPPORTED;
+
+    p->gpu = p->gl->gpu;
+    ctx->renderer = pl_renderer_create(p->pl_log, p->gpu);
+    if (!ctx->renderer)
+        return MPV_ERROR_VO_INIT_FAILED;
+
+    ctx->gpu = p->gpu;
+    ctx->pl_log = p->pl_log;
+    return 0;
+}
+
+static int gl_wrap_fbo(struct libmpv_gpu_next_context *ctx,
+                       mpv_render_param *params, pl_tex *out_tex)
+{
+    struct priv *p = ctx->priv;
+
+    mpv_opengl_fbo *fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_OPENGL_FBO, NULL);
+    if (!fbo || fbo->w <= 0 || fbo->h <= 0)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    // Reuse the wrapper for the same FBO; a resize may keep the same FBO name,
+    // so the dimensions are part of the key.
+    if (p->wrapped_tex && p->wrapped_fbo == fbo->fbo &&
+        p->wrapped_w == fbo->w && p->wrapped_h == fbo->h)
+    {
+        *out_tex = p->wrapped_tex;
+        return 0;
+    }
+
+    pl_tex_destroy(p->gpu, &p->wrapped_tex);
+    p->wrapped_fbo = 0;
+    p->wrapped_tex = pl_opengl_wrap(p->gpu, pl_opengl_wrap_params(
+        .framebuffer = fbo->fbo,
+        .width = fbo->w,
+        .height = fbo->h,
+        .iformat = fbo->internal_format
+    ));
+    if (!p->wrapped_tex) {
+        MP_ERR(ctx, "Failed to wrap provided FBO as a libplacebo texture.\n");
+        return MPV_ERROR_GENERIC;
+    }
+    p->wrapped_fbo = fbo->fbo;
+    p->wrapped_w = fbo->w;
+    p->wrapped_h = fbo->h;
+
+    *out_tex = p->wrapped_tex;
+    return 0;
+}
+
+static void gl_destroy(struct libmpv_gpu_next_context *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    // May be called after a partial gl_init() failure.
+    if (!p)
+        return;
+
+    if (p->gpu)
+        pl_tex_destroy(p->gpu, &p->wrapped_tex);
+    pl_renderer_destroy(&ctx->renderer);
+    pl_opengl_destroy(&p->gl);
+    pl_log_destroy(&p->pl_log);
+}
+
+const struct libmpv_gpu_next_context_fns libmpv_gpu_next_context_gl = {
+    .api_name = MPV_RENDER_API_TYPE_OPENGL,
+    .init = gl_init,
+    .wrap_fbo = gl_wrap_fbo,
+    .destroy = gl_destroy,
+};
+#endif
+
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+
+struct priv_d3d11 {
+    pl_log pl_log;
+    pl_d3d11 d3d11;
+    pl_gpu gpu;
+    pl_tex wrapped_tex;
+    ID3D11Texture2D *wrapped_tex_res;
+    int wrapped_w, wrapped_h;
+};
+
+// Tear down the auxiliary ra_ctx set up for the hwdec interop. This must not
+// go through ra_ctx_destroy(), since it has no ra_ctx_fns of its own.
+static void d3d11_destroy_ra(struct ra_ctx *ra_ctx)
+{
+    if (!ra_ctx)
+        return;
+
+    if (ra_ctx->ra) {
+        ra_ctx->ra->fns->destroy(ra_ctx->ra);
+        ra_ctx->ra = NULL;
+    }
+    if (ra_ctx->spirv && ra_ctx->spirv->fns->uninit)
+        ra_ctx->spirv->fns->uninit(ra_ctx);
+    talloc_free(ra_ctx);
+}
+
+static int d3d11_init(struct libmpv_gpu_next_context *ctx, mpv_render_param *params)
+{
+    struct priv_d3d11 *p = ctx->priv = talloc_zero(ctx, struct priv_d3d11);
+
+    mpv_d3d11_init_params *d3d11_params =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_D3D11_INIT_PARAMS, NULL);
+    if (!d3d11_params || !d3d11_params->device)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    p->pl_log = mppl_log_create(ctx, ctx->log);
+    if (!p->pl_log)
+        return MPV_ERROR_VO_INIT_FAILED;
+    mppl_log_set_probing(p->pl_log, false);
+
+    p->d3d11 = pl_d3d11_create(p->pl_log, pl_d3d11_params(
+        .device = d3d11_params->device
+    ));
+    if (!p->d3d11)
+        return MPV_ERROR_UNSUPPORTED;
+
+    p->gpu = p->d3d11->gpu;
+    ctx->renderer = pl_renderer_create(p->pl_log, p->gpu);
+    if (!ctx->renderer)
+        return MPV_ERROR_VO_INIT_FAILED;
+
+    // The hwdec interop needs a ra_ctx to attach to. It is only used to map
+    // hwdec frames, never to present.
+    struct ra_ctx *ra_ctx = talloc_zero(p, struct ra_ctx);
+    ra_ctx->log = ctx->log;
+    ra_ctx->global = ctx->global;
+    if (!spirv_compiler_init(ra_ctx) ||
+        !(ra_ctx->ra = ra_d3d11_create(d3d11_params->device, ctx->log,
+                                       ra_ctx->spirv)))
+    {
+        MP_ERR(ctx, "Failed to create the D3D11 hwdec interop context.\n");
+        d3d11_destroy_ra(ra_ctx);
+        return MPV_ERROR_VO_INIT_FAILED;
+    }
+    ctx->ra_ctx = ra_ctx;
+
+    ctx->gpu = p->gpu;
+    ctx->pl_log = p->pl_log;
+    return 0;
+}
+
+static int d3d11_wrap_fbo(struct libmpv_gpu_next_context *ctx,
+                          mpv_render_param *params, pl_tex *out_tex)
+{
+    struct priv_d3d11 *p = ctx->priv;
+
+    mpv_d3d11_fbo *fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_D3D11_FBO, NULL);
+    if (!fbo || !fbo->tex)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    // mpv_d3d11_fbo carries no dimensions, so query them from the texture.
+    ID3D11Texture2D *tex = (ID3D11Texture2D *)fbo->tex;
+    D3D11_TEXTURE2D_DESC desc = {0};
+    ID3D11Texture2D_GetDesc(tex, &desc);
+    if (!desc.Width || !desc.Height)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    // Swap chain back buffers are recycled, so cache the wrapper. The resource
+    // alone is not a sufficient key: a resize reuses it with new dimensions.
+    if (p->wrapped_tex && p->wrapped_tex_res == tex &&
+        p->wrapped_w == desc.Width && p->wrapped_h == desc.Height)
+    {
+        *out_tex = p->wrapped_tex;
+        return 0;
+    }
+
+    pl_tex_destroy(p->gpu, &p->wrapped_tex);
+    p->wrapped_tex_res = NULL;
+    p->wrapped_tex = pl_d3d11_wrap(p->gpu, pl_d3d11_wrap_params(
+        .tex = (ID3D11Resource *)tex,
+        .w = desc.Width,
+        .h = desc.Height
+    ));
+    if (!p->wrapped_tex) {
+        MP_ERR(ctx, "Failed to wrap provided D3D11 texture.\n");
+        return MPV_ERROR_GENERIC;
+    }
+    p->wrapped_tex_res = tex;
+    p->wrapped_w = desc.Width;
+    p->wrapped_h = desc.Height;
+
+    *out_tex = p->wrapped_tex;
+    return 0;
+}
+
+static void d3d11_done_frame(struct libmpv_gpu_next_context *ctx)
+{
+    // Submit queued GPU work without waiting, like ra_d3d11_flush().
+    pl_gpu_flush(ctx->gpu);
+}
+
+static void d3d11_destroy(struct libmpv_gpu_next_context *ctx)
+{
+    struct priv_d3d11 *p = ctx->priv;
+
+    // May be called after a partial d3d11_init() failure.
+    if (!p)
+        return;
+
+    if (p->gpu) {
+        pl_gpu_flush(p->gpu);
+        pl_tex_destroy(p->gpu, &p->wrapped_tex);
+    }
+    p->wrapped_tex_res = NULL;
+    pl_renderer_destroy(&ctx->renderer);
+    d3d11_destroy_ra(ctx->ra_ctx);
+    ctx->ra_ctx = NULL;
+    pl_d3d11_destroy(&p->d3d11);
+    pl_log_destroy(&p->pl_log);
+}
+
+const struct libmpv_gpu_next_context_fns libmpv_gpu_next_context_d3d11 = {
+    .api_name = MPV_RENDER_API_TYPE_D3D11,
+    .init = d3d11_init,
+    .wrap_fbo = d3d11_wrap_fbo,
+    .done_frame = d3d11_done_frame,
+    .destroy = d3d11_destroy,
+};
+#endif
diff --git a/video/out/gpu_next/libmpv_gpu_next.c b/video/out/gpu_next/libmpv_gpu_next.c
new file mode 100644
index 0000000000..e5a665049b
--- /dev/null
+++ b/video/out/gpu_next/libmpv_gpu_next.c
@@ -0,0 +1,217 @@
+#include <string.h>
+
+#include "config.h"
+#include "libmpv_gpu_next.h"
+#include "options/m_config.h"
+#include "ta/ta_talloc.h"
+#include "video/hwdec.h"
+#include "video/out/gpu/video.h"
+#include "video/out/libmpv.h"
+#include "video.h"
+
+struct priv {
+    struct libmpv_gpu_next_context *context;
+    struct pl_video *video_engine;
+};
+
+static const struct libmpv_gpu_next_context_fns *context_backends[] = {
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
+    &libmpv_gpu_next_context_gl,
+#endif
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    &libmpv_gpu_next_context_d3d11,
+#endif
+    NULL
+};
+
+static void load_hwdec_api(void *ctx, struct hwdec_imgfmt_request *params)
+{
+    struct render_backend *rb = ctx;
+    struct priv *p = rb->priv;
+
+    if (p->video_engine)
+        pl_video_load_hwdecs(p->video_engine, params);
+}
+
+static int init(struct render_backend *ctx, mpv_render_param *params)
+{
+    char *api = get_mpv_render_param(params, MPV_RENDER_PARAM_API_TYPE, NULL);
+    if (!api)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    const struct libmpv_gpu_next_context_fns *backend = NULL;
+    for (int n = 0; context_backends[n]; n++) {
+        if (strcmp(context_backends[n]->api_name, api) == 0) {
+            backend = context_backends[n];
+            break;
+        }
+    }
+    // Report the API as unsupported so the caller can try another backend.
+    if (!backend)
+        return MPV_ERROR_NOT_IMPLEMENTED;
+
+    ctx->priv = talloc_zero(ctx, struct priv);
+    struct priv *p = ctx->priv;
+
+    p->context = talloc_zero(p, struct libmpv_gpu_next_context);
+    *p->context = (struct libmpv_gpu_next_context){
+        .log = ctx->log,
+        .global = ctx->global,
+        .fns = backend,
+    };
+
+    int err = backend->init(p->context, params);
+    if (err < 0)
+        return err;
+
+    p->video_engine = pl_video_init(ctx->global, ctx->log,
+                                    p->context->pl_log, p->context->gpu,
+                                    p->context->renderer);
+    if (!p->video_engine)
+        return MPV_ERROR_VO_INIT_FAILED;
+
+    ctx->hwdec_devs = hwdec_devices_create();
+    if (!ctx->hwdec_devs)
+        return MPV_ERROR_VO_INIT_FAILED;
+
+    if (p->context->ra_ctx) {
+        // Set up the hwdec interop on the backend's ra_ctx, using the same
+        // "hwdec-interop" option as vo_gpu_next. The cache is owned by p.
+        struct m_config_cache *gl_opts_cache =
+            m_config_cache_alloc(p, ctx->global, &gl_video_conf);
+        struct gl_video_opts *gl_opts = gl_opts_cache->opts;
+        hwdec_devices_set_loader(ctx->hwdec_devs, load_hwdec_api, ctx);
+        pl_video_init_hwdecs(p->video_engine, p->context->ra_ctx,
+                             ctx->hwdec_devs, gl_opts->hwdec_interop);
+    }
+
+    ctx->driver_caps = VO_CAP_ROTATE90 | VO_CAP_VFLIP;
+    return 0;
+}
+
+static bool check_format(struct render_backend *ctx, int imgfmt)
+{
+    struct priv *p = ctx->priv;
+
+    return pl_video_check_format(p->video_engine, imgfmt);
+}
+
+static int set_parameter(struct render_backend *ctx, mpv_render_param param)
+{
+    return MPV_ERROR_NOT_IMPLEMENTED;
+}
+
+static void reconfig(struct render_backend *ctx, struct mp_image_params *params)
+{
+    struct priv *p = ctx->priv;
+
+    pl_video_reconfig(p->video_engine);
+}
+
+static void reset(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    pl_video_reset(p->video_engine);
+}
+
+static void update_external(struct render_backend *ctx, struct vo *vo)
+{
+    struct priv *p = ctx->priv;
+
+    pl_video_update_osd(p->video_engine, vo ? vo->osd : NULL);
+}
+
+static void resize(struct render_backend *ctx, struct mp_rect *src,
+                   struct mp_rect *dst, struct mp_osd_res *osd)
+{
+    struct priv *p = ctx->priv;
+
+    pl_video_resize(p->video_engine, src, dst, osd);
+}
+
+static int get_target_size(struct render_backend *ctx, mpv_render_param *params,
+                           int *out_w, int *out_h)
+{
+    struct priv *p = ctx->priv;
+
+    pl_tex tex;
+    int err = p->context->fns->wrap_fbo(p->context, params, &tex);
+    if (err < 0)
+        return err;
+    *out_w = tex->params.w;
+    *out_h = tex->params.h;
+    return 0;
+}
+
+static int render(struct render_backend *ctx, mpv_render_param *params,
+                  struct vo_frame *frame)
+{
+    struct priv *p = ctx->priv;
+
+    // Mapping the surface is cheap, better than adding new backend entrypoints.
+    pl_tex tex;
+    int err = p->context->fns->wrap_fbo(p->context, params, &tex);
+    if (err < 0)
+        return err;
+
+    bool flip = GET_MPV_RENDER_PARAM(params, MPV_RENDER_PARAM_FLIP_Y, int, 0);
+
+    pl_video_render(p->video_engine, frame, tex, flip);
+
+    if (p->context->fns->done_frame)
+        p->context->fns->done_frame(p->context);
+
+    return 0;
+}
+
+static struct mp_image *get_image(struct render_backend *ctx, int imgfmt,
+                                  int w, int h, int stride_align, int flags)
+{
+    struct priv *p = ctx->priv;
+
+    return pl_video_get_image(p->video_engine, imgfmt, w, h, stride_align, flags);
+}
+
+static void screenshot(struct render_backend *ctx, struct vo_frame *frame,
+                       struct voctrl_screenshot *args)
+{
+    struct priv *p = ctx->priv;
+
+    args->res = pl_video_screenshot(p->video_engine, frame);
+}
+
+static void destroy(struct render_backend *ctx)
+{
+    struct priv *p = ctx->priv;
+
+    // Uninit the engine (and with it the hwdec interop) before the device
+    // list, which the interop unregisters itself from.
+    pl_video_uninit(&p->video_engine);
+    if (ctx->hwdec_devs) {
+        hwdec_devices_set_loader(ctx->hwdec_devs, NULL, NULL);
+        hwdec_devices_destroy(ctx->hwdec_devs);
+        ctx->hwdec_devs = NULL;
+    }
+    if (p->context) {
+        // destroy() tolerates a partially initialized context.
+        p->context->fns->destroy(p->context);
+        talloc_free(p->context);
+        p->context = NULL;
+    }
+}
+
+const struct render_backend_fns render_backend_gpu_next = {
+    .init = init,
+    .check_format = check_format,
+    .set_parameter = set_parameter,
+    .reconfig = reconfig,
+    .reset = reset,
+    .update_external = update_external,
+    .resize = resize,
+    .get_target_size = get_target_size,
+    .render = render,
+    .get_image = get_image,
+    .screenshot = screenshot,
+    .destroy = destroy,
+};
diff --git a/video/out/gpu_next/libmpv_gpu_next.h b/video/out/gpu_next/libmpv_gpu_next.h
new file mode 100644
index 0000000000..0bc2838afd
--- /dev/null
+++ b/video/out/gpu_next/libmpv_gpu_next.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <libplacebo/gpu.h>
+#include <libplacebo/renderer.h>
+#include "mpv/render.h"
+
+struct mpv_global;
+
+// Backend-specific glue for the 'gpu-next' libmpv render backend: creates the
+// libplacebo GPU for the client's API and wraps the target surface.
+struct libmpv_gpu_next_context {
+    struct mp_log *log;
+    struct mpv_global *global;
+    void *priv;
+
+    const struct libmpv_gpu_next_context_fns *fns;
+
+    // Set by init(); the GPU is owned by the backend, the renderer by us.
+    pl_log pl_log;
+    pl_gpu gpu;
+    pl_renderer renderer;
+
+    // Anchor for the hwdec interop; not used for output.
+    struct ra_ctx *ra_ctx;
+};
+
+struct libmpv_gpu_next_context_fns {
+    const char *api_name;
+    int (*init)(struct libmpv_gpu_next_context *ctx, mpv_render_param *params);
+    // Wrap the surface passed to mpv_render_context_render() into a pl_tex.
+    // The result is owned by the backend and reused across frames.
+    int (*wrap_fbo)(struct libmpv_gpu_next_context *ctx,
+                    mpv_render_param *params, pl_tex *out);
+    // Called after rendering a frame. Optional.
+    void (*done_frame)(struct libmpv_gpu_next_context *ctx);
+    // Free all data in ctx->priv, including ctx->renderer and ctx->gpu.
+    void (*destroy)(struct libmpv_gpu_next_context *ctx);
+};
+
+extern const struct libmpv_gpu_next_context_fns libmpv_gpu_next_context_gl;
+extern const struct libmpv_gpu_next_context_fns libmpv_gpu_next_context_d3d11;
+
diff --git a/video/out/gpu_next/video.c b/video/out/gpu_next/video.c
new file mode 100644
index 0000000000..b231d14300
--- /dev/null
+++ b/video/out/gpu_next/video.c
@@ -0,0 +1,1240 @@
+#include <stddef.h>
+#include <stdint.h>
+
+#include <libplacebo/colorspace.h>
+#include <libplacebo/gpu.h>
+#include <libplacebo/options.h>
+#include <libplacebo/renderer.h>
+#include <libplacebo/utils/frame_queue.h>
+#include <libplacebo/utils/upload.h>
+
+#include "common/common.h"
+#include "common/msg.h"
+#include "options/m_config.h"
+#include "sub/draw_bmp.h"
+#include "sub/osd.h"
+#include "ta/ta_talloc.h"
+#include "video/csputils.h"
+#include "video/hwdec.h"
+#include "video/img_format.h"
+#include "video/mp_image.h"
+#include "video/out/gpu/hwdec.h"
+#include "video/out/gpu/video.h"
+#include "video/out/gpu_next/vo_gpu_next.h"
+#include "video/out/placebo/ra_pl.h"
+#include "video/out/vo.h"
+#include "video.h"
+
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
+#include <libplacebo/opengl.h>
+#include "video/out/opengl/ra_gl.h"
+#endif
+
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+#include <libplacebo/d3d11.h>
+#include "osdep/windows_utils.h"
+#include "video/out/d3d11/ra_d3d11.h"
+#endif
+
+// Upper bound on the number of host-mapped buffers handed out through
+// pl_video_get_image() and still referenced by the client.
+#define MP_MAX_DR_BUFFERS 128
+
+struct osd_entry {
+    pl_tex tex;
+    struct pl_overlay_part *parts;
+    int num_parts;
+    int change_id;              // sub_bitmaps.change_id baked into tex
+};
+
+struct pl_osd_state {
+    struct osd_entry entries[MAX_OSD_PARTS];
+    struct pl_overlay overlays[MAX_OSD_PARTS];
+};
+
+struct pl_video {
+    struct mp_log *log;
+    struct mpv_global *global;
+    pl_log pllog;               // borrowed from the API context layer
+    pl_gpu gpu;                 // borrowed from the API context layer
+    pl_renderer renderer;       // owned by the API context layer
+    pl_queue queue;
+
+    uint64_t last_id;           // Highest frame_id pushed so far (reset-aware).
+    double last_pts;
+    bool want_reset;            // Queue must be flushed before the next push.
+    bool flush_cache;           // Renderer cache must be dropped once.
+    uint64_t osd_sync;          // Bumped whenever the OSD changes.
+
+    struct mp_rect current_dst;
+    struct mp_rect current_src;
+    struct osd_state *current_osd_state;
+
+    struct mp_osd_res osd_res;
+    struct pl_osd_state osd_state;
+    pl_fmt osd_fmt[SUBBITMAP_COUNT];
+    pl_tex *sub_tex;
+    int num_sub_tex;
+
+    // Hardware decoding interop, only used with an ra_ctx (currently D3D11).
+    struct mp_hwdec_devices *hwdec_devs;
+    struct ra_hwdec_ctx hwdec_ctx;
+    struct ra_hwdec_mapper *hwdec_mapper;
+
+    struct mp_csp_equalizer_state *video_eq;
+
+    // Host-mapped buffers handed out via pl_video_get_image(), so that
+    // upload_frame() can reference them without a copy.
+    mp_mutex dr_lock;
+    pl_buf *dr_buffers;
+    int num_dr_buffers;
+
+    struct m_config_cache *opts_cache;
+    struct gl_next_opts *opts;
+
+    // Kept persistent so libplacebo only recompiles what actually changed.
+    struct m_config_cache *gl_opts_cache;
+    struct gl_video_opts *gl_opts;
+    pl_options pars;
+};
+
+struct frame_priv {
+    struct pl_video *p;
+    struct ra_hwdec *hwdec;
+    uint64_t signature;         // unique per queue entry, see render()
+    uint64_t osd_sync;          // OSD version baked into this frame's overlays
+    struct pl_osd_state subs;   // per-frame overlays when blending subtitles
+};
+
+static pl_buf get_dr_buf(struct pl_video *p, const uint8_t *ptr)
+{
+    mp_mutex_lock(&p->dr_lock);
+
+    for (int i = 0; i < p->num_dr_buffers; i++) {
+        pl_buf buf = p->dr_buffers[i];
+        if (ptr >= buf->data && ptr < buf->data + buf->params.size) {
+            mp_mutex_unlock(&p->dr_lock);
+            return buf;
+        }
+    }
+
+    mp_mutex_unlock(&p->dr_lock);
+    return NULL;
+}
+
+// Whether a swdec image can be handed to libplacebo as UNORM planes.
+static bool format_supported(struct pl_video *p, int format, bool use_uint)
+{
+    struct pl_bit_encoding bits;
+    struct pl_plane_data data[4] = {0};
+    int planes = plane_data_from_imgfmt(data, &bits, format, use_uint);
+    if (!planes)
+        return false;
+
+    for (int i = 0; i < planes; i++) {
+        if (!pl_plane_find_fmt(p->gpu, NULL, &data[i]))
+            return false;
+    }
+
+    return true;
+}
+
+static void upload_frame_cleanup(struct pl_video *p, struct pl_frame *frame)
+{
+    if (!frame)
+        return;
+    for (int i = 0; i < frame->num_planes; i++)
+        pl_tex_destroy(p->gpu, &frame->planes[i].texture);
+    frame->num_planes = 0;
+}
+
+// Upload an mp_image into a pl_frame. The caller must free the textures with
+// upload_frame_cleanup().
+static bool upload_frame(struct pl_video *p, struct pl_frame *out_frame,
+                         const struct mp_image *img)
+{
+    *out_frame = (struct pl_frame){
+        .color = img->params.color,
+        .repr = img->params.repr,
+        .crop = { .x0 = 0, .y0 = 0, .x1 = img->w, .y1 = img->h },
+    };
+
+    // Integer formats that cannot be sampled as UNORM fall back to UINT,
+    // like upload_planes_sw() in vo_gpu_next.
+    bool use_uint = !format_supported(p, img->imgfmt, false);
+    struct pl_plane_data data[4] = {0};
+    int planes = plane_data_from_imgfmt(data, &out_frame->repr.bits,
+                                        img->imgfmt, use_uint);    if (!planes) {
+        MP_ERR(p, "Failed to describe image format '%s'\n",
+               mp_imgfmt_to_name(img->imgfmt));
+        return false;
+    }
+
+    out_frame->num_planes = planes;
+
+    // pl_upload_plane() does not modify the mp_image; the cast drops const
+    // only because the plane helpers take a non-const pointer.
+    struct mp_image *mpi = (struct mp_image *)img;
+    for (int n = 0; n < planes; n++) {
+        data[n].width = mp_image_plane_w(mpi, n);
+        data[n].height = mp_image_plane_h(mpi, n);
+        if (img->stride[n] < 0) {
+            data[n].pixels = img->planes[n] + (data[n].height - 1) * img->stride[n];
+            data[n].row_stride = -img->stride[n];
+            out_frame->planes[n].flipped = true;
+        } else {
+            data[n].pixels = img->planes[n];
+            data[n].row_stride = img->stride[n];
+        }
+
+        pl_buf buf = get_dr_buf(p, data[n].pixels);
+        if (buf) {
+            data[n].buf = buf;
+            data[n].buf_offset = (uint8_t *)data[n].pixels - buf->data;
+            data[n].pixels = NULL;
+        } else if (p->gpu->limits.callbacks) {
+            // Keep the image alive until the async upload is done.
+            data[n].callback = talloc_free;
+            data[n].priv = mp_image_new_ref(mpi);
+        }
+
+        if (!pl_upload_plane(p->gpu, &out_frame->planes[n],
+                             &out_frame->planes[n].texture, &data[n])) {
+            MP_ERR(p, "Failed to upload mp_image plane %d\n", n);
+            talloc_free(data[n].priv);
+            upload_frame_cleanup(p, out_frame);
+            return false;
+        }
+
+        // Without async callback support, we have to poll...
+        if (!p->gpu->limits.callbacks && data[n].buf)
+            while (pl_buf_poll(p->gpu, data[n].buf, UINT64_MAX));
+    }
+
+    pl_frame_set_chroma_location(out_frame, img->params.chroma_location);
+    return true;
+}
+
+static bool hwdec_reconfig(struct pl_video *p, struct ra_hwdec *hwdec,
+                           const struct mp_image_params *par)
+{
+    if (p->hwdec_mapper) {
+        if (mp_image_params_static_equal(par, &p->hwdec_mapper->src_params)) {
+            p->hwdec_mapper->src_params.repr.dovi = par->repr.dovi;
+            p->hwdec_mapper->dst_params.repr.dovi = par->repr.dovi;
+            p->hwdec_mapper->src_params.color.hdr = par->color.hdr;
+            p->hwdec_mapper->dst_params.color.hdr = par->color.hdr;
+            return true;
+        } else {
+            ra_hwdec_mapper_free(&p->hwdec_mapper);
+        }
+    }
+
+    p->hwdec_mapper = ra_hwdec_mapper_create(hwdec, par);
+    if (!p->hwdec_mapper) {
+        MP_ERR(p, "Initializing texture for hardware decoding failed.\n");
+        return false;
+    }
+
+    return true;
+}
+
+// For RAs not based on ra_pl, this creates a new pl_tex wrapper
+static pl_tex hwdec_get_tex(struct pl_video *p, int n)
+{
+    struct ra_tex *ratex = p->hwdec_mapper->tex[n];
+    struct ra *ra = p->hwdec_mapper->ra;
+    if (ra_pl_get(ra))
+        return (pl_tex) ratex->priv;
+
+#if HAVE_GL && defined(PL_HAVE_OPENGL)
+    if (ra_is_gl(ra) && pl_opengl_get(p->gpu)) {
+        struct pl_opengl_wrap_params par = {
+            .width = ratex->params.w,
+            .height = ratex->params.h,
+        };
+
+        ra_gl_get_format(ratex->params.format, &par.iformat,
+                         &(GLenum){0}, &(GLenum){0});
+        ra_gl_get_raw_tex(ra, ratex, &par.texture, &par.target);
+        return pl_opengl_wrap(p->gpu, &par);
+    }
+#endif
+
+#if HAVE_D3D11 && defined(PL_HAVE_D3D11)
+    if (ra_is_d3d11(ra)) {
+        int array_slice = 0;
+        ID3D11Resource *res = ra_d3d11_get_raw_tex(ra, ratex, &array_slice);
+        pl_tex tex = pl_d3d11_wrap(p->gpu, pl_d3d11_wrap_params(
+            .tex = res,
+            .array_slice = array_slice,
+            .fmt = ra_d3d11_get_format(ratex->params.format),
+            .w = ratex->params.w,
+            .h = ratex->params.h,
+        ));
+        SAFE_RELEASE(res);
+        return tex;
+    }
+#endif
+
+    MP_ERR(p, "Failed mapping hwdec frame? Open a bug!\n");
+    return NULL;
+}
+
+// Fill `frame->num_planes` and per-plane component_mapping from an
+// hwdec-mapped imgfmt description.
+static void setup_hwdec_plane_mapping(struct pl_frame *frame,
+                                      struct mp_imgfmt_desc *desc)
+{
+    frame->num_planes = desc->num_planes;
+    for (int n = 0; n < frame->num_planes; n++) {
+        struct pl_plane *plane = &frame->planes[n];
+        int *map = plane->component_mapping;
+        for (int c = 0; c < mp_imgfmt_desc_get_num_comps(desc); c++) {
+            if (desc->comps[c].plane != n)
+                continue;
+
+            // Sort by component offset
+            uint8_t offset = desc->comps[c].offset;
+            int index = plane->components++;
+            while (index > 0 && desc->comps[map[index - 1]].offset > offset) {
+                map[index] = map[index - 1];
+                index--;
+            }
+            map[index] = c;
+        }
+    }
+}
+
+static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame->user_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video *p = fp->p;
+
+    if (!hwdec_reconfig(p, fp->hwdec, &mpi->params))
+        return false;
+
+    if (ra_hwdec_mapper_map(p->hwdec_mapper, mpi) < 0) {
+        MP_ERR(p, "Mapping hardware decoded surface failed.\n");
+        return false;
+    }
+
+    bool ok = true;
+    for (int n = 0; n < frame->num_planes; n++) {
+        frame->planes[n].texture = hwdec_get_tex(p, n);
+        ok &= !!frame->planes[n].texture;
+    }
+
+    if (!ok) {
+        // Roll back before libplacebo sees an unusable frame.
+        if (!ra_pl_get(p->hwdec_mapper->ra)) {
+            for (int n = 0; n < frame->num_planes; n++)
+                pl_tex_destroy(p->gpu, &frame->planes[n].texture);
+        }
+        ra_hwdec_mapper_unmap(p->hwdec_mapper);
+        return false;
+    }
+
+    return true;
+}
+
+static void hwdec_release(pl_gpu gpu, struct pl_frame *frame)
+{
+    struct mp_image *mpi = frame->user_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video *p = fp->p;
+
+    // Wrappers created by hwdec_get_tex() unless backed by ra_pl, in which
+    // case they are owned by the mapper.
+    if (!ra_pl_get(p->hwdec_mapper->ra)) {
+        for (int n = 0; n < frame->num_planes; n++) {
+            pl_tex_destroy(p->gpu, &frame->planes[n].texture);
+            frame->planes[n].texture = NULL;
+        }
+    }
+    ra_hwdec_mapper_unmap(p->hwdec_mapper);
+}
+
+static bool map_frame(pl_gpu gpu, pl_tex *tex, const struct pl_source_frame *src,
+                      struct pl_frame *frame)
+{
+    struct mp_image *mpi = src->frame_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video *p = fp->p;
+
+    struct mp_image_params par = mpi->params;
+    fp->hwdec = p->hwdec_devs ? ra_hwdec_get(&p->hwdec_ctx, mpi->imgfmt) : NULL;
+    if (fp->hwdec) {
+        // Reconfig the mapper (creating it if needed) to access `dst_params`.
+        if (!hwdec_reconfig(p, fp->hwdec, &mpi->params))
+            return false;
+
+        par = p->hwdec_mapper->dst_params;
+    }
+
+    mp_image_params_guess_csp(&par);
+
+    *frame = (struct pl_frame) {
+        .color = par.color,
+        .repr = par.repr,
+        .profile = {
+            .data = mpi->icc_profile ? mpi->icc_profile->data : NULL,
+            .len = mpi->icc_profile ? mpi->icc_profile->size : 0,
+        },
+        .rotation = par.rotate / 90,
+        .user_data = mpi,
+    };
+
+    // Honor the reference white override and the sRGB->gamma22 knob, which
+    // are baked into the mapped frame (see pl_video_reconfig()).
+    const struct gl_video_opts *opts = p->gl_opts;
+    if (opts->hdr_reference_white && !pl_color_transfer_is_hdr(frame->color.transfer))
+        frame->color.hdr.max_luma = opts->hdr_reference_white;
+
+    if ((opts->treat_srgb_as_power22 & 1) &&
+        frame->color.transfer == PL_COLOR_TRC_SRGB)
+    {
+        // The sRGB EOTF is a pure gamma 2.2 function. See reference display in
+        // IEC 61966-2-1-1999. Linearize sRGB to display light.
+        frame->color.transfer = PL_COLOR_TRC_GAMMA22;
+    }
+
+    if (fp->hwdec) {
+        struct mp_imgfmt_desc desc = mp_imgfmt_get_desc(par.imgfmt);
+        frame->acquire = hwdec_acquire;
+        frame->release = hwdec_release;
+        setup_hwdec_plane_mapping(frame, &desc);
+
+        pl_frame_set_chroma_location(frame, par.chroma_location);
+        return true;
+    }
+
+    if (!upload_frame(p, frame, mpi))
+        return false;
+
+    pl_frame_set_chroma_location(frame, par.chroma_location);
+    pl_icc_profile_compute_signature(&frame->profile);
+    return true;
+}
+
+static void unmap_frame(pl_gpu gpu, struct pl_frame *frame,
+                        const struct pl_source_frame *src)
+{
+    struct mp_image *mpi = src->frame_data;
+    struct frame_priv *fp = mpi->priv;
+    struct pl_video *p = fp->p;
+
+    // hwdec frames are mapped by hwdec_acquire() and torn down by
+    // hwdec_release(), which libplacebo pairs with a successful acquire().
+    if (!fp->hwdec)
+        upload_frame_cleanup(p, frame);
+
+    // Per-frame overlay textures are recycled here, as update_overlays() does
+    // for the shared state; libplacebo released its references already.
+    for (int i = 0; i < MAX_OSD_PARTS; i++) {
+        struct osd_entry *entry = &fp->subs.entries[i];
+        if (entry->tex)
+            MP_TARRAY_APPEND(p, p->sub_tex, p->num_sub_tex, entry->tex);
+        entry->tex = NULL;
+        talloc_free(entry->parts);
+    }
+
+    talloc_free(mpi);
+}
+
+static void discard_frame(const struct pl_source_frame *src)
+{
+    // Only called for frames that were never mapped, so there is nothing to
+    // release. map_frame() rolls back its own partial mappings on failure.
+    talloc_free(src->frame_data);
+}
+
+struct pl_video *pl_video_init(struct mpv_global *global, struct mp_log *log,
+                               pl_log pllog, pl_gpu gpu, pl_renderer renderer)
+{
+    struct pl_video *p = talloc_zero(NULL, struct pl_video);
+    p->log = log;
+    p->global = global;
+    p->pllog = pllog;
+    p->gpu = gpu;
+    p->renderer = renderer;
+    p->queue = pl_queue_create(gpu);
+
+    // Pre-find the texture formats we'll need for OSD bitmaps for efficiency.
+    p->osd_fmt[SUBBITMAP_LIBASS] = pl_find_fmt(gpu, PL_FMT_UNORM, 1, 8, 8, 0);
+    p->osd_fmt[SUBBITMAP_BGRA]   = pl_find_fmt(gpu, PL_FMT_UNORM, 4, 8, 8, 0);
+
+    p->video_eq = mp_csp_equalizer_create(p, global);
+
+    mp_mutex_init(&p->dr_lock);
+
+    p->opts_cache = m_config_cache_alloc(p, global, &gl_next_conf);
+    p->opts = p->opts_cache->opts;
+
+    // User-facing scaler/deband/tone-mapping/... options, like vo_gpu_next.
+    p->gl_opts_cache = m_config_cache_alloc(p, global, &gl_video_conf);
+    p->gl_opts = p->gl_opts_cache->opts;
+
+    // Persistent render options; libplacebo keys its shader caches off these.
+    p->pars = pl_options_alloc(p->pllog);
+    if (!p->pars) {
+        MP_ERR(p, "Failed allocating libplacebo render options!\n");
+        pl_video_uninit(&p);
+        return NULL;
+    }
+
+    return p;
+}
+
+void pl_video_init_hwdecs(struct pl_video *p, struct ra_ctx *ra_ctx,
+                          struct mp_hwdec_devices *devs, const char *interop)
+{
+    p->hwdec_devs = devs;
+    p->hwdec_ctx = (struct ra_hwdec_ctx) {
+        .log = p->log,
+        .global = p->global,
+        .ra_ctx = ra_ctx,
+    };
+
+    // Preload the interop drivers: the render backend caches check_format()
+    // results before the decoder requests a format, so lazy loading would
+    // force a HW download.
+    ra_hwdec_ctx_init(&p->hwdec_ctx, devs, interop, true);
+}
+
+void pl_video_load_hwdecs(struct pl_video *p, struct hwdec_imgfmt_request *params)
+{
+    ra_hwdec_ctx_load_fmt(&p->hwdec_ctx, p->hwdec_devs, params);
+}
+
+static void free_dr_buf(void *opaque, uint8_t *data)
+{
+    struct pl_video *p = opaque;
+
+    mp_mutex_lock(&p->dr_lock);
+
+    // Set to NULL by pl_video_uninit(); the GPU may already be gone.
+    if (!p->gpu) {
+        mp_mutex_unlock(&p->dr_lock);
+        return;
+    }
+
+    for (int i = 0; i < p->num_dr_buffers; i++) {
+        if (p->dr_buffers[i]->data == data) {
+            pl_buf_destroy(p->gpu, &p->dr_buffers[i]);
+            MP_TARRAY_REMOVE_AT(p->dr_buffers, p->num_dr_buffers, i);
+            mp_mutex_unlock(&p->dr_lock);
+            return;
+        }
+    }
+
+    mp_mutex_unlock(&p->dr_lock);
+    MP_ASSERT_UNREACHABLE();
+}
+
+struct mp_image *pl_video_get_image(struct pl_video *p, int imgfmt, int w, int h,
+                                    int stride_align, int flags)
+{
+    pl_gpu gpu = p->gpu;
+    if (!gpu->limits.thread_safe || !gpu->limits.max_mapped_size)
+        return NULL;
+
+    if ((flags & VO_DR_FLAG_HOST_CACHED) && !gpu->limits.host_cached)
+        return NULL;
+
+    stride_align = mp_lcm(stride_align, gpu->limits.align_tex_xfer_pitch);
+    stride_align = mp_lcm(stride_align, gpu->limits.align_tex_xfer_offset);
+    int size = mp_image_get_alloc_size(imgfmt, w, h, stride_align);
+    if (size < 0)
+        return NULL;
+
+    // Pad by one row so get_dr_buf()'s range check covers the last plane.
+    pl_buf buf = pl_buf_create(gpu, &(struct pl_buf_params) {
+        .memory_type = PL_BUF_MEM_HOST,
+        .host_mapped = true,
+        .size = size + stride_align,
+    });
+    if (!buf)
+        return NULL;
+
+    struct mp_image *mpi = mp_image_from_buffer(imgfmt, w, h, stride_align,
+                                                buf->data, buf->params.size,
+                                                p, free_dr_buf);
+    if (!mpi) {
+        pl_buf_destroy(gpu, &buf);
+        return NULL;
+    }
+
+    mp_mutex_lock(&p->dr_lock);
+    // Refuse to grow the pool without bound.
+    bool ok = p->num_dr_buffers < MP_MAX_DR_BUFFERS;
+    if (ok)
+        MP_TARRAY_APPEND(p, p->dr_buffers, p->num_dr_buffers, buf);
+    mp_mutex_unlock(&p->dr_lock);
+
+    if (!ok) {
+        MP_WARN(p, "DR buffer pool exhausted (%d buffers), falling back to "
+                   "software decoding.\n", MP_MAX_DR_BUFFERS);
+        pl_buf_destroy(gpu, &buf);
+        talloc_free(mpi);
+        return NULL;
+    }
+
+    return mpi;
+}
+
+bool pl_video_check_format(struct pl_video *p, int imgfmt)
+{
+    // hwdec formats are mapped by the interop, not uploaded to libplacebo.
+    if (p->hwdec_devs && ra_hwdec_get(&p->hwdec_ctx, imgfmt))
+        return true;
+
+    struct pl_bit_encoding bits;
+    struct pl_plane_data data[4] = {0};
+    int planes = plane_data_from_imgfmt(data, &bits, imgfmt, false);
+    if (!planes)
+        planes = plane_data_from_imgfmt(data, &bits, imgfmt, true);
+    if (!planes) {
+        if (!p->hwdec_devs && mp_imgfmt_get_desc(imgfmt).flags & MP_IMGFLAG_HWACCEL)
+            MP_VERBOSE(p, "Format '%s' is a hwdec format, but the active API "
+                       "backend provides no hwdec interop.\n",
+                       mp_imgfmt_to_name(imgfmt));
+        return false;
+    }
+
+    for (int i = 0; i < planes; i++) {
+        if (!pl_plane_find_fmt(p->gpu, NULL, &data[i]))
+            return false;
+    }
+
+    return true;
+}
+
+void pl_video_uninit(struct pl_video **p_ptr)
+{
+    struct pl_video *p = *p_ptr;
+    if (!p)
+        return;
+
+    // Drain in-flight uploads before destroying the resources they read from.
+    if (p->gpu)
+        pl_gpu_finish(p->gpu);
+
+    ra_hwdec_mapper_free(&p->hwdec_mapper);
+    if (p->hwdec_devs)
+        ra_hwdec_ctx_uninit(&p->hwdec_ctx);
+
+    // Drain the queue first: mapped frames may still reference our DR buffers.
+    pl_queue_destroy(&p->queue);
+
+    for (int i = 0; i < MAX_OSD_PARTS; i++) {
+        struct osd_entry *entry = &p->osd_state.entries[i];
+        pl_tex_destroy(p->gpu, &entry->tex);
+        talloc_free(entry->parts);
+    }
+    for (int i = 0; i < p->num_sub_tex; i++)
+        pl_tex_destroy(p->gpu, &p->sub_tex[i]);
+    talloc_free(p->sub_tex);
+
+    if (p->pars)
+        pl_options_free(&p->pars);
+
+    // Stop free_dr_buf() from touching the GPU, which the API context owns.
+    mp_mutex_lock(&p->dr_lock);
+    for (int i = 0; i < p->num_dr_buffers; i++)
+        pl_buf_destroy(p->gpu, &p->dr_buffers[i]);
+    p->num_dr_buffers = 0;
+    p->gpu = NULL;
+    mp_mutex_unlock(&p->dr_lock);
+    talloc_free(p->dr_buffers);
+    mp_mutex_destroy(&p->dr_lock);
+
+    talloc_free(p);
+    *p_ptr = NULL;
+}
+
+static bool upload_overlay_tex(struct pl_video *p, struct osd_entry *entry,
+                               const struct sub_bitmaps *item)
+{
+    pl_fmt tex_fmt = p->osd_fmt[item->format];
+    if (!entry->tex)
+        MP_TARRAY_POP(p->sub_tex, p->num_sub_tex, &entry->tex);
+    // pl_tex_recreate() invalidates the texture even when it keeps it, so
+    // only call it when the size or format has to change. Textures only
+    // ever grow, so a size mismatch means the texture is too small.
+    pl_tex tex = entry->tex;
+    if (!tex || tex->params.w < item->packed_w ||
+        tex->params.h < item->packed_h || tex->params.format != tex_fmt)
+    {
+        entry->change_id = 0;
+        bool ok = pl_tex_recreate(p->gpu, &entry->tex, &(struct pl_tex_params) {
+            .format = tex_fmt,
+            .w = MPMAX(item->packed_w, tex ? tex->params.w : 0),
+            .h = MPMAX(item->packed_h, tex ? tex->params.h : 0),
+            .host_writable = true,
+            .sampleable = true,
+        });
+        if (!ok) {
+            MP_ERR(p, "Failed recreating OSD texture!\n");
+            return false;
+        }
+    }
+    // Bitmaps are often identical between frames (static subtitles).
+    if (entry->change_id == item->change_id)
+        return true;
+
+    struct pl_tex_transfer_params upload_params = {
+        .tex        = entry->tex,
+        .rc         = { .x1 = item->packed_w, .y1 = item->packed_h, },
+        .row_pitch  = item->packed->stride[0],
+        .ptr        = item->packed->planes[0],
+    };
+    // Keep the image alive until it's fully read.
+    if (p->gpu->limits.callbacks) {
+        upload_params.callback = talloc_free;
+        upload_params.priv = mp_image_new_ref(item->packed);
+    }
+    if (!pl_tex_upload(p->gpu, &upload_params)) {
+        MP_ERR(p, "Failed uploading OSD texture!\n");
+        talloc_free(upload_params.priv);
+        entry->change_id = 0;
+        return false;
+    }
+    entry->change_id = item->change_id;
+    return true;
+}
+
+static void update_overlays(struct pl_video *p, struct mp_osd_res res,
+                            int flags, enum pl_overlay_coords coords,
+                            struct pl_osd_state *state, struct pl_frame *frame,
+                            struct mp_image *src)
+{
+    frame->num_overlays = 0;
+    if (!p->current_osd_state)
+        return;
+
+    // Recycle the textures of the previous frame.
+    for (int i = 0; i < MAX_OSD_PARTS; i++) {
+        struct osd_entry *entry = &state->entries[i];
+        if (entry->tex)
+            MP_TARRAY_APPEND(p, p->sub_tex, p->num_sub_tex, entry->tex);
+        entry->tex = NULL;
+    }
+
+    double pts = src ? src->pts : 0;
+    struct sub_bitmap_list *subs = osd_render(p->current_osd_state, res, pts,
+                                              flags, mp_draw_sub_formats);
+    if (!subs)
+        return;
+
+    frame->overlays = state->overlays;
+
+    for (int n = 0; n < subs->num_items; n++) {
+        const struct sub_bitmaps *item = subs->items[n];
+        if (!item->num_parts || !item->packed)
+            continue;
+
+        struct osd_entry *entry = &state->entries[item->render_index];
+        if (!upload_overlay_tex(p, entry, item))
+            break;
+
+        // Only LIBASS bitmaps carry per-part colors; BGRA overlays are
+        // premultiplied and keep the source colorspace.
+        bool mono = item->format == SUBBITMAP_LIBASS;
+        struct pl_color_space color = pl_color_space_srgb;
+
+        if (src) {
+            // Muxed image subtitles and overlays tagged with video_color_space
+            // live in the colorspace of the video.
+            if (mono && item->video_color_space &&
+                !pl_color_transfer_is_hdr(src->params.color.transfer))
+            {
+                color = src->params.color;
+            } else if (!mono) {
+                color = src->params.color;
+            }
+
+            if (mono) {
+                if (pl_color_transfer_is_hdr(frame->color.transfer) &&
+                    p->opts->sub_hdr_peak)
+                {
+                    color.hdr = (struct pl_hdr_metadata) {
+                        .max_luma = p->opts->sub_hdr_peak,
+                    };
+                }
+            } else if (pl_color_transfer_is_hdr(color.transfer)) {
+                if (!pl_color_transfer_is_hdr(frame->color.transfer)) {
+                    // Tone map against SDR white.
+                    color.hdr = (struct pl_hdr_metadata) {
+                        .max_luma = PL_COLOR_SDR_WHITE,
+                    };
+                } else if (p->opts->image_subs_hdr_peak != -1) {
+                    color.hdr = (struct pl_hdr_metadata) {
+                        .max_luma = p->opts->image_subs_hdr_peak,
+                    };
+                }
+            }
+        }
+
+        entry->num_parts = 0;
+        talloc_free(entry->parts);
+        entry->parts = NULL;
+
+        for (int i = 0; i < item->num_parts; i++) {
+            const struct sub_bitmap *b = &item->parts[i];
+            if (b->dw == 0 || b->dh == 0)
+                continue;
+
+            struct pl_overlay_part part = {
+                .src = { b->src_x, b->src_y, b->src_x + b->w, b->src_y + b->h },
+                .dst = { b->x, b->y, b->x + b->dw, b->y + b->dh },
+            };
+            if (mono) {
+                uint32_t c = b->libass.color;
+                part.color[0] = (c >> 24) / 255.0f;
+                part.color[1] = ((c >> 16) & 0xFF) / 255.0f;
+                part.color[2] = ((c >> 8) & 0xFF) / 255.0f;
+                part.color[3] = (255 - (c & 0xFF)) / 255.0f;
+            }
+            MP_TARRAY_APPEND(p, entry->parts, entry->num_parts, part);
+        }
+
+        struct pl_overlay *ol = &state->overlays[frame->num_overlays++];
+        *ol = (struct pl_overlay) {
+            .tex = entry->tex,
+            .parts = entry->parts,
+            .num_parts = entry->num_parts,
+            .color = color,
+            .coords = coords,
+        };
+
+        if (mono) {
+            ol->mode = PL_OVERLAY_MONOCHROME;
+            ol->repr.alpha = PL_ALPHA_INDEPENDENT;
+        } else {
+            ol->mode = PL_OVERLAY_NORMAL;
+            ol->repr.alpha = PL_ALPHA_PREMULTIPLIED;
+        }
+    }
+
+    talloc_free(subs);
+}
+
+// Translate mpv's rotated/flipped display rect into libplacebo's unrotated
+// `pl_frame.crop` convention, mirroring apply_crop() in vo_gpu_next.c.
+static void apply_crop(struct pl_frame *frame, struct mp_rect crop,
+                       int width, int height)
+{
+    frame->crop = (struct pl_rect2df) {
+        .x0 = crop.x0,
+        .y0 = crop.y0,
+        .x1 = crop.x1,
+        .y1 = crop.y1,
+    };
+
+    // mpv gives us rotated/flipped rects, libplacebo expects unrotated
+    pl_rect2df_rotate(&frame->crop, -frame->rotation);
+    if (frame->crop.x1 < frame->crop.x0) {
+        frame->crop.x0 = width - frame->crop.x0;
+        frame->crop.x1 = width - frame->crop.x1;
+    }
+
+    if (frame->crop.y1 < frame->crop.y0) {
+        frame->crop.y0 = height - frame->crop.y0;
+        frame->crop.y1 = height - frame->crop.y1;
+    }
+}
+
+void pl_video_render(struct pl_video *p, struct vo_frame *frame,
+                     pl_tex target_tex, bool flip)
+{
+    if (!p || !target_tex)
+        return;
+
+    m_config_cache_update(p->gl_opts_cache);
+    m_config_cache_update(p->opts_cache);
+
+    struct pl_frame target = {
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = target_tex,
+            .flipped = flip,
+            .components = 4,
+            .component_mapping = { 0, 1, 2, 3 },
+        },
+        .color = pl_color_space_srgb,
+        .repr = pl_color_repr_rgb,
+    };
+    apply_crop(&target, p->current_dst, target_tex->params.w,
+               target_tex->params.h);
+
+    // Mirror vo_gpu_next's draw_frame() decisions.
+    bool will_redraw = frame && frame->display_synced && frame->num_vsyncs > 1;
+    bool can_interpolate = p->gl_opts->interpolation && frame &&
+                           frame->display_synced && !frame->still &&
+                           frame->num_frames > 1;
+    bool interpolate = can_interpolate &&
+                       frame->ideal_frame_vsync_duration > 0;
+    double pts_offset = interpolate ? frame->ideal_frame_vsync : 0;
+
+    // MPV_RENDER_PARAM_FLIP_Y already flipped the target; a stream-level
+    // vflip cancels it, like vo_gpu_next's distort_params.
+    if (frame && frame->current && frame->current->params.vflip) {
+        target.planes[0].flipped = !target.planes[0].flipped;
+    }
+
+    // libplacebo rejects non-monotonic PTS, so refill the queue if the current
+    // frame is behind it (e.g. right after a seek).
+    struct pl_source_frame vpts;
+    if (frame && frame->current && !p->want_reset) {
+        if (pl_queue_peek(p->queue, 0, &vpts) &&
+            frame->current->pts + MPMAX(0, pts_offset) < vpts.pts)
+        {
+            MP_VERBOSE(p, "Forcing queue refill, PTS(%f + %f | %f) < VPTS(%f)\n",
+                       frame->current->pts, pts_offset,
+                       frame->ideal_frame_vsync_duration, vpts.pts);
+            p->want_reset = true;
+        }
+    }
+
+    // frames[0] is the current one; push every not-yet-seen frame.
+    if (frame) {
+        for (int n = 0; n < frame->num_frames; n++) {
+            uint64_t id = frame->frame_id + n;
+
+            if (p->want_reset) {
+                // The queue requires monotonically increasing PTS, and the
+                // renderer cache may still reference dropped frames.
+                pl_queue_reset(p->queue);
+                p->last_pts = 0.0;
+                p->last_id = 0;
+                p->want_reset = false;
+                p->flush_cache = true;
+            }
+
+            if (p->flush_cache) {
+                pl_renderer_flush_cache(p->renderer);
+                p->flush_cache = false;
+            }
+
+            if (id <= p->last_id)
+                continue; // ignore already seen frames
+
+            struct mp_image *mpi = mp_image_new_ref(frame->frames[n]);
+            struct frame_priv *fp = talloc_zero(mpi, struct frame_priv);
+            fp->p = p;
+            fp->signature = id;
+            mpi->priv = fp;
+
+            pl_queue_push(p->queue, &(struct pl_source_frame) {
+                .pts = mpi->pts,
+                // Zero duration disables frame mixing for this entry.
+                .duration = interpolate ? frame->approx_duration : 0,
+                .frame_data = mpi,
+                .map = map_frame,
+                .unmap = unmap_frame,
+                .discard = discard_frame,
+            });
+
+            p->last_id = id;
+        }
+    }
+
+    struct pl_frame_mix mix = {0};
+
+    if (frame && frame->current) {
+        struct pl_queue_params qparams = *pl_queue_params(
+            .pts = frame->current->pts + pts_offset,
+            .radius = pl_frame_mix_radius(&p->pars->params),
+            // Zero disables frame-mixing interpolation.
+            .vsync_duration = interpolate ? frame->ideal_frame_vsync_duration : 0,
+            .interpolation_threshold = p->gl_opts->interpolation_threshold,
+        );
+#if PL_API_VER >= 340
+        // We drive the queue with source PTS, so disable drift compensation.
+        qparams.drift_compensation = 0;
+#endif
+
+        // Clamp to the first queued frame: the demuxer PTS does not start at 0.
+        struct pl_source_frame first;
+        if (pl_queue_peek(p->queue, 0, &first) && qparams.pts < first.pts) {
+            if (first.pts != frame->current->pts)
+                MP_VERBOSE(p, "Current PTS(%f) != VPTS(%f)\n",
+                           frame->current->pts, first.pts);
+            MP_VERBOSE(p, "Clamping first frame PTS from %f to %f\n",
+                       qparams.pts, first.pts);
+            qparams.pts = first.pts;
+        }
+        p->last_pts = qparams.pts;
+
+        switch (pl_queue_update(p->queue, &mix, &qparams)) {
+        case PL_QUEUE_ERR:
+            MP_ERR(p, "Failed updating frames!\n");
+            return;
+        case PL_QUEUE_EOF:
+            abort(); // we never signal EOF
+        case PL_QUEUE_MORE:
+            // Expected near the start and end of a file.
+            if (!(frame && frame->still))
+                MP_DBG(p, "Render queue underrun.\n");
+            break;
+        case PL_QUEUE_OK:
+            break;
+        }
+    } else {
+        // OSD-only redraw: reuse the last PTS without advancing the queue.
+        struct pl_queue_params qparams = *pl_queue_params(.pts = p->last_pts);
+#if PL_API_VER >= 340
+        qparams.drift_compensation = 0;
+#endif
+        pl_queue_update(p->queue, &mix, &qparams);
+    }
+
+    // A redraw invalidates the OSD but not the video frames; bump the version
+    // once per redraw.
+    if (frame && frame->redraw)
+        p->osd_sync++;
+
+    // Must happen before pl_render_image_mix(), which otherwise derives the
+    // crop from the (not yet acquired) hwdec plane texture.
+    for (int i = 0; i < mix.num_frames; i++) {
+        struct pl_frame *image = (struct pl_frame *)mix.frames[i];
+        struct mp_image *mpi = image->user_data;
+        struct frame_priv *fp = mpi->priv;
+        apply_crop(image, p->current_src, mpi->params.w, mpi->params.h);
+
+        if (!p->gl_opts->blend_subs) {
+            image->num_overlays = 0;
+            fp->osd_sync = 0;
+            continue;
+        }
+
+        // Blend subtitles per frame, so interpolated or reused frames get
+        // the OSD state belonging to their own PTS.
+        if (fp->osd_sync < p->osd_sync) {
+            update_overlays(p, p->osd_res, OSD_DRAW_SUB_ONLY,
+                            PL_OVERLAY_COORDS_DST_CROP, &fp->subs, image, mpi);
+            fp->osd_sync = p->osd_sync;
+        }
+    }
+
+    // Use frame IDs (mp_image pointers get recycled), clamped to avoid
+    // overflowing the stack with a custom frame mixer. The OSD sync value
+    // keeps identical frames with a different OSD distinct.
+    uint64_t signatures[32];
+    int num_sig = MPMIN(mix.num_frames, MP_ARRAY_SIZE(signatures));
+    for (int i = 0; i < num_sig; i++) {
+        struct pl_frame *image = (struct pl_frame *)mix.frames[i];
+        struct mp_image *mpi = image->user_data;
+        struct frame_priv *fp = mpi->priv;
+        signatures[i] = fp->signature ^ (fp->osd_sync << 48);
+    }
+    if (num_sig) {
+        mix.signatures = signatures;
+        mix.num_frames = num_sig;
+    }
+
+    // Null when there is no video; overlays then render on black.
+    struct mp_image *ref = mix.num_frames > 0 ? mix.frames[0]->user_data : NULL;
+    update_overlays(p, p->osd_res,
+                    (frame && frame->current && p->gl_opts->blend_subs)
+                        ? OSD_DRAW_OSD_ONLY : 0,
+                    PL_OVERLAY_COORDS_DST_FRAME, &p->osd_state, &target, ref);
+
+    struct pl_render_params params = p->pars->params;
+
+    struct pl_color_adjustment color_adj;
+    struct mp_csp_params cparams = MP_CSP_PARAMS_DEFAULTS;
+    mp_csp_equalizer_state_get(p->video_eq, &cparams);
+    color_adj.brightness = cparams.brightness;
+    color_adj.contrast   = cparams.contrast;
+    color_adj.hue        = cparams.hue;
+    color_adj.saturation = cparams.saturation;
+    color_adj.gamma      = cparams.gamma;
+    params.color_adjustment = &color_adj;
+
+    params.preserve_mixing_cache = p->opts->inter_preserve && !(frame && frame->still);
+    if (frame && frame->still)
+        params.frame_mixer = NULL;
+    // Cache only frames that will be reused.
+    bool cache_frame = frame && (will_redraw || frame->still);
+    params.skip_caching_single_frame = !cache_frame;
+
+    // The target is a client-provided texture wrapped by pl_*_wrap(), which
+    // cannot be flagged blit_dst; therefore it must not be cleared by
+    // libplacebo (clearing is implemented as a blit). The client owns the
+    // surface and is responsible for its contents anyway.
+    params.background = PL_CLEAR_SKIP;
+    params.border = PL_CLEAR_SKIP;
+
+    if (!pl_render_image_mix(p->renderer, &mix, &target, &params))
+        MP_ERR(p, "Rendering failed.\n");
+}
+
+struct mp_image *pl_video_screenshot(struct pl_video *p, struct vo_frame *frame)
+{
+    if (!p || !frame || !frame->current)
+        return NULL;
+
+    struct mp_image *res = NULL;
+    struct pl_frame source = {0};
+    pl_tex fbo = NULL;
+
+    if (!upload_frame(p, &source, frame->current)) {
+        MP_ERR(p, "Failed to upload source image for screenshot.\n");
+        return NULL;
+    }
+
+    // A screenshot must not depend on the reference luminance baked into the
+    // source by map_frame().
+    if (!pl_color_transfer_is_hdr(source.color.transfer))
+        source.color.hdr.max_luma = 0;
+
+    // Apply the same source crop that is used for display.
+    apply_crop(&source, p->current_src, frame->current->params.w,
+               frame->current->params.h);
+
+    int w = frame->current->w, h = frame->current->h;
+    if (frame->current->params.rotate % 180 == 90)
+        MPSWAP(int, w, h);
+
+    int mpfmt = IMGFMT_RGBA;
+    pl_fmt fmt = NULL;
+    if (p->gl_opts->dither_depth > 8) {
+        fmt = pl_find_fmt(p->gpu, PL_FMT_UNORM, 4, 16, 16,
+                          PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_HOST_READABLE);
+        if (fmt)
+            mpfmt = IMGFMT_RGBA64;
+    }
+    if (!fmt) {
+        fmt = pl_find_fmt(p->gpu, PL_FMT_UNORM, 4, 8, 8,
+                          PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_HOST_READABLE);
+    }
+    if (!fmt) {
+        MP_ERR(p, "Failed to find screenshot format.\n");
+        goto done;
+    }
+
+    fbo = pl_tex_create(p->gpu, pl_tex_params(
+        .w = w,
+        .h = h,
+        .format = fmt,
+        .blit_dst = true,
+        .renderable = true,
+        .host_readable = true,
+        .storable = fmt->caps & PL_FMT_CAP_STORABLE
+    ));
+    if (!fbo) {
+        MP_ERR(p, "Failed to create screenshot texture.\n");
+        goto done;
+    }
+
+    // SDR sRGB output, matching playback.
+    struct pl_frame target = {
+        .num_planes = 1,
+        .planes[0] = {
+            .texture = fbo,
+            .components = 4,
+            .component_mapping = { 0, 1, 2, 3 },
+        },
+        .color = pl_color_space_srgb,
+        .repr = pl_color_repr_rgb,
+    };
+    apply_crop(&target, (struct mp_rect){0, 0, w, h}, w, h);
+
+    // sRGB reference display is pure 2.2 power function, see IEC 61966-2-1-1999.
+    // Round-trip back to sRGB if the source is also sRGB; otherwise use the
+    // piecewise function, as expected for file encoding.
+    if ((p->gl_opts->treat_srgb_as_power22 & 1) &&
+        target.color.transfer == PL_COLOR_TRC_SRGB &&
+        frame->current->params.color.transfer == PL_COLOR_TRC_SRGB)
+    {
+        target.color.transfer = PL_COLOR_TRC_GAMMA22;
+    }
+
+    struct mp_osd_res osd = {
+        .w = w,
+        .h = h,
+        .display_par = 1.0, // Screenshots have square pixels
+    };
+    // Use a separate OSD state so the playback OSD version is untouched.
+    struct pl_osd_state sub_state = {0};
+    update_overlays(p, osd, 0, PL_OVERLAY_COORDS_DST_FRAME, &sub_state, &target,
+                    frame->current);
+
+    struct pl_render_params params = p->pars->params;
+    params.skip_caching_single_frame = true;
+    params.frame_mixer = NULL;
+    params.preserve_mixing_cache = false;
+    if (!pl_render_image(p->renderer, &source, &target, &params)) {
+        MP_ERR(p, "Screenshot rendering failed.\n");
+        goto done;
+    }
+
+    res = mp_image_alloc(mpfmt, w, h);
+    if (!res) {
+        MP_ERR(p, "Failed to allocate screenshot image.\n");
+        goto done;
+    }
+
+    res->params.color.primaries = target.color.primaries;
+    res->params.color.transfer = target.color.transfer;
+    res->params.color.hdr = target.color.hdr;
+    res->params.repr.levels = target.repr.levels;
+
+    if (!pl_tex_download(p->gpu, pl_tex_transfer_params(
+        .tex = fbo,
+        .ptr = res->planes[0],
+        .row_pitch = res->stride[0],
+    ))) {
+        MP_ERR(p, "Screenshot texture download failed.\n");
+        talloc_free(res);
+        res = NULL;
+    }
+
+done:
+    pl_tex_destroy(p->gpu, &fbo);
+    for (int i = 0; i < MAX_OSD_PARTS; i++) {
+        pl_tex_destroy(p->gpu, &sub_state.entries[i].tex);
+        talloc_free(sub_state.entries[i].parts);
+    }
+    upload_frame_cleanup(p, &source);
+    return res;
+}
+
+void pl_video_reconfig(struct pl_video *p)
+{
+    // Frame parameters are read from mpi->params in map_frame(); only the
+    // option caches need refreshing here.
+    bool changed = m_config_cache_update(p->opts_cache);
+    changed = m_config_cache_update(p->gl_opts_cache) || changed;
+    if (!changed)
+        return;
+
+    // Some options are baked into already queued frames by map_frame().
+    p->want_reset = true;
+}
+
+void pl_video_resize(struct pl_video *p, const struct mp_rect *src,
+                     const struct mp_rect *dst, const struct mp_osd_res *osd)
+{
+    if (src)
+        p->current_src = *src;
+    if (dst)
+        p->current_dst = *dst;
+    if (osd)
+        p->osd_res = *osd;
+}
+
+void pl_video_update_osd(struct pl_video *p, struct osd_state *osd)
+{
+    p->current_osd_state = osd;
+}
+
+void pl_video_reset(struct pl_video *p)
+{
+    // Defer so the PTS counter resets together with the queue.
+    p->want_reset = true;
+}
+
