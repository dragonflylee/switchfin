# Maintainer: Alexey Pavlov <alexpux@gmail.com>

_realname=fribidi
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.0.17
pkgrel=1
pkgdesc="A Free Implementation of the Unicode Bidirectional Algorithm (mingw-w64)"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'clangarm64')
license=('spdx:LGPL-2.1-or-later')
url="https://github.com/fribidi/fribidi"
depends=()
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-cc"
)
source=("${url}/releases/download/v${pkgver}/fribidi-${pkgver}.tar.xz")
sha256sums=('6949dcde27d41cebad1fd741fcafc36d55a1020d2d872d4a6eb3914caabbada2')

build() {
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    ${MINGW_PREFIX}/bin/meson.exe setup \
      --prefix="${MINGW_PREFIX}" \
      --buildtype=release \
      --default-library=static \
      -Dbin=false -Ddocs=false -Dtests=false \
      build-${MSYSTEM} \
      "${srcdir}/${_realname}-${pkgver}"

  ${MINGW_PREFIX}/bin/meson.exe compile -C build-${MSYSTEM}
}

package() {
  meson install -C build-${MSYSTEM} --destdir="${pkgdir}"
}