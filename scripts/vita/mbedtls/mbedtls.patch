     *olen = len;
     return 0;
+#elif defined(__vita__)
+	((void) file);
+	((void) read_len);
+	if (vita_getentropy_wrapper(output, len) == -1) {
+		return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;
+	}
+	*olen = len;
+	return 0;
 #else
 
     *olen = 0;
