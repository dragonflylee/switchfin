     return ioctlsocket(ctx->fd, FIONBIO, &n);
+#elif defined(__vita__)
+    long b = 0L;
+    return setsockopt(ctx->fd, SOL_SOCKET, SO_NONBLOCK, &b, sizeof(b));
 #else
