pkgname=mpv
pkgver=0.36.0
pkgrel=5
url="https://mpv.io/"
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/mpv-player/mpv/archive/v${pkgver}.tar.gz" "gxm.patch" "ao-buffer.patch")
sha256sums=('SKIP' 'SKIP' 'SKIP')
depends=('libass' 'ffmpeg')

prepare() {
  cd $pkgname-$pkgver
  patch --strip=1 --input=${srcdir}/gxm.patch
  patch --strip=1 --input=${srcdir}/ao-buffer.patch
}

build() {
  cd $pkgname-$pkgver
  meson setup build --prefix=$prefix --cross-file crossfile.txt  \
      --default-library static \
      -Diconv=disabled \
      -Dlua=disabled  \
      -Djpeg=disabled \
      -Dopensles=disabled \
      -Dlibavdevice=disabled \
      -Dlibarchive=disabled \
      -Dmanpage-build=disabled \
      -Dhtml-build=disabled \
      -Dsdl2=disabled \
      -Dlibmpv=true \
      -Dgxm=enabled \
      -Dvitashark=disabled \
      -Dcplayer=false

  meson compile -C build
}

package () {
  cd $pkgname-$pkgver
  DESTDIR=$pkgdir meson install -C build
}