+enum ps5_tiled_copy_result {
+   PS5_TILED_COPY_UNSUPPORTED,
+   PS5_TILED_COPY_DONE,
+   PS5_TILED_COPY_OUT_OF_BOUNDS,
+};
+
+/* Switchfin: CPU copies between a linear transfer staging image and native
+ * tiled color storage. The address of (x, y) equals, for the 256-pixel chunk
+ * base C = x & ~255, row = offset(C, y) combined with x_offsets[x - C]; this is
+ * the decomposition already used by ps5_stage_color_surface. A run of G texels
+ * starting on a G boundary is copied together only when the equation itself
+ * places them at consecutive addresses. Each texel keeps the original bounds
+ * test: to_tiled skips out-of-range texels; reads report the first failure. */
+static enum ps5_tiled_copy_result
+ps5_tiled_color_transfer_copy_impl(struct ps5_resource *resource,
+                              const struct pipe_box *box, size_t layer_base,
+                              uint8_t *staging, size_t staging_stride,
+                              unsigned format_size, bool to_tiled)
+{
+   const enum pipe_format format = resource->base.format;
+   const unsigned width = ps5_tiled_rgba8_width(resource);
+   size_t x_offsets[256];
+   unsigned group = 1;
+
+   if (!staging || box->x < 0 || box->y < 0 || box->width <= 0 ||
+       box->height <= 0 || box->depth != 1 ||
+       util_format_get_blocksize(format) != format_size ||
+       (uint64_t)(unsigned)box->width * (unsigned)box->height < 1024u)
+      return PS5_TILED_COPY_UNSUPPORTED;
+   for (unsigned x = 0; x < ARRAY_SIZE(x_offsets); ++x) {
+      x_offsets[x] = ps5_tiled_color_offset(format, x, 0, width);
+      if (x_offsets[x] == SIZE_MAX)
+         return PS5_TILED_COPY_UNSUPPORTED;
+   }
+   /* Largest verified group: every aligned run starts with clear run address
+    * bits, its X terms are consecutive, and no Y term touches those bits. The
+    * XOR with any row then cannot carry, so the run's addresses are contiguous. */
+   for (unsigned candidate = 8; candidate > 1 && group == 1; candidate >>= 1) {
+      const size_t span = (size_t)candidate * format_size;
+      bool contiguous = true;
+
+      for (unsigned x = 0; contiguous && x < ARRAY_SIZE(x_offsets); ++x)
+         contiguous = !(x_offsets[x & ~(candidate - 1u)] & (span - 1u)) &&
+                      x_offsets[x] ==
+                      x_offsets[x & ~(candidate - 1u)] +
+                         (size_t)(x & (candidate - 1u)) * format_size;
+      for (unsigned y = 0; contiguous && y < 256; ++y) {
+         const size_t row = ps5_tiled_color_offset(format, 0, y, width);
+
+         contiguous = row != SIZE_MAX && !(row & (span - 1u) & 0xffff);
+      }
+      if (contiguous)
+         group = candidate;
+   }
+
+   for (unsigned y = 0; y < (unsigned)box->height; ++y) {
+      const unsigned py = (unsigned)box->y + y;
+      const uint8_t *linear_row = staging + (size_t)y * staging_stride;
+      unsigned x = 0;
+
+      while (x < (unsigned)box->width) {
+         const unsigned px = (unsigned)box->x + x;
+         const unsigned chunk = px & ~255u;
+         const size_t row = ps5_tiled_color_offset(format, chunk, py, width);
+         unsigned end = MIN2((unsigned)box->width, x + (256u - (px - chunk)));
+
+         if (row == SIZE_MAX)
+            return PS5_TILED_COPY_UNSUPPORTED;
+         /* Every texel of this chunk lies below the last X term's tile end:
+          * X tile terms are nondecreasing and each local address is < 64 KiB. */
+         const size_t chunk_base = row & ~(size_t)0xffff;
+         const size_t chunk_limit = x_offsets[255] & ~(size_t)0xffff;
+         if (group > 1 && chunk_base <= SIZE_MAX - chunk_limit - 0x10000u &&
+             layer_base <= SIZE_MAX - chunk_base - chunk_limit - 0x10000u &&
+             layer_base + chunk_base + chunk_limit + 0x10000u <=
+                resource->allocation_size) {
+            const uint8_t *data = resource->data + layer_base;
+            const size_t low = row & 0xffff;
+
+            for (; x < end && ((unsigned)box->x + x - chunk) & (group - 1u); ++x) {
+               const unsigned k = (unsigned)box->x + x - chunk;
+               const size_t at = chunk_base + (x_offsets[k] & ~(size_t)0xffff) +
+                                 ((low ^ x_offsets[k]) & 0xffff);
+               if (to_tiled)
+                  memcpy((uint8_t *)data + at, linear_row + (size_t)x * format_size, format_size);
+               else
+                  memcpy((uint8_t *)linear_row + (size_t)x * format_size, data + at, format_size);
+            }
+            for (; end - x >= group; x += group) {
+               const unsigned k = (unsigned)box->x + x - chunk;
+               const size_t at = chunk_base + (x_offsets[k] & ~(size_t)0xffff) +
+                                 ((low ^ x_offsets[k]) & 0xffff);
+               const size_t bytes = (size_t)group * format_size;
+               if (to_tiled)
+                  memcpy((uint8_t *)data + at, linear_row + (size_t)x * format_size, bytes);
+               else
+                  memcpy((uint8_t *)linear_row + (size_t)x * format_size, data + at, bytes);
+            }
+            for (; x < end; ++x) {
+               const unsigned k = (unsigned)box->x + x - chunk;
+               const size_t at = chunk_base + (x_offsets[k] & ~(size_t)0xffff) +
+                                 ((low ^ x_offsets[k]) & 0xffff);
+               if (to_tiled)
+                  memcpy((uint8_t *)data + at, linear_row + (size_t)x * format_size, format_size);
+               else
+                  memcpy((uint8_t *)linear_row + (size_t)x * format_size, data + at, format_size);
+            }
+            continue;
+         }
+         while (x < end) {
+            const unsigned k = (unsigned)box->x + x - chunk;
+            const unsigned run = !(k & (group - 1u)) && end - x >= group ? group : 1u;
+            const size_t bytes = (size_t)run * format_size;
+            const size_t local = (row & ~(size_t)0xffff) +
+                                 (x_offsets[k] & ~(size_t)0xffff) +
+                                 ((row ^ x_offsets[k]) & 0xffff);
+            const size_t tiled = layer_base + local;
+
+            if (run > 1 &&
+                (layer_base > SIZE_MAX - local ||
+                 tiled > resource->allocation_size ||
+                 resource->allocation_size - tiled < bytes)) {
+               /* Partial range: the scalar path applies the original test. */
+               for (unsigned i = 0; i < run; ++i) {
+                  const size_t one = layer_base +
+                     (row & ~(size_t)0xffff) +
+                     (x_offsets[k + i] & ~(size_t)0xffff) +
+                     ((row ^ x_offsets[k + i]) & 0xffff);
+
+                  if (one <= resource->allocation_size &&
+                      resource->allocation_size - one >= format_size) {
+                     if (to_tiled)
+                        memcpy(resource->data + one,
+                               linear_row + (size_t)(x + i) * format_size,
+                               format_size);
+                     else
+                        memcpy((uint8_t *)linear_row + (size_t)(x + i) * format_size,
+                               resource->data + one, format_size);
+                  } else if (!to_tiled) {
+                     return PS5_TILED_COPY_OUT_OF_BOUNDS;
+                  }
+               }
+            } else if (tiled <= resource->allocation_size &&
+                       resource->allocation_size - tiled >= bytes) {
+               if (to_tiled)
+                  memcpy(resource->data + tiled,
+                         linear_row + (size_t)x * format_size, bytes);
+               else
+                  memcpy((uint8_t *)linear_row + (size_t)x * format_size,
+                         resource->data + tiled, bytes);
+            } else if (!to_tiled) {
+               return PS5_TILED_COPY_OUT_OF_BOUNDS;
+            }
+            x += run;
+         }
+      }
+   }
+   return PS5_TILED_COPY_DONE;
+}
