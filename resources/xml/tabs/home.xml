<brls:Box
    width="auto"
    height="auto">

    <!-- centered: cf. suggest_show.xml (natural stole the focus) -->
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <!-- no side padding here: each row carries its own (sidePadding)
             so the cards scroll up to the edges -->
        <brls:Box
            axis="column"
            id="home/box"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
