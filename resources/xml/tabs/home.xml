<brls:Box
    width="auto"
    height="auto">

    <!-- centered : cf. suggest_show.xml (le natural volait le focus) -->
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <!-- pas de padding latéral ici : chaque rangée porte le sien
             (sidePadding) pour que les cartes défilent jusqu'aux bords -->
        <brls:Box
            axis="column"
            id="home/box"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

        </brls:Box>

    </brls:ScrollingFrame>

</brls:Box>
