<brls:Box
    width="auto"
    height="auto"
    alignItems="center"
    justifyContent="center">

    <brls:Box
        width="640"
        axis="column"
        alignItems="center">

        <brls:Image
            width="84"
            height="84"
            cornerRadius="20"
            marginBottom="16"
            scalingType="fit"
            image="@res/icon/icon.png" />

        <brls:Label
            fontSize="16"
            marginBottom="30"
            textColor="@theme/font/grey"
            text="@i18n/main/plex/title" />

        <brls:Box
            axis="column"
            alignItems="center"
            cornerRadius="14"
            paddingTop="24"
            paddingBottom="20"
            paddingLeft="56"
            paddingRight="56"
            marginBottom="26"
            backgroundColor="@theme/color/surface">

            <brls:Label
                id="plex/label/code"
                fontSize="56"
                marginBottom="10"
                text="· · · ·" />

            <brls:Label
                id="plex/label/status"
                fontSize="15"
                textColor="@theme/font/grey"
                text="@i18n/main/plex/generating" />
        </brls:Box>

        <brls:Box
            axis="column"
            alignItems="flexStart"
            marginBottom="26">

            <brls:Label
                fontSize="15"
                marginBottom="6"
                textColor="@theme/font/grey"
                text="@i18n/main/plex/step1" />

            <brls:Label
                fontSize="15"
                marginBottom="6"
                textColor="@theme/font/grey"
                text="@i18n/main/plex/step2" />

            <brls:Label
                fontSize="15"
                textColor="@theme/font/grey"
                text="@i18n/main/plex/step3" />
        </brls:Box>

        <brls:Button
            id="plex/retry"
            style="bordered"
            paddingLeft="30"
            paddingRight="30"
            text="@i18n/main/plex/regenerate" />

    </brls:Box>
</brls:Box>
