<!--
    Search (UI_REDESIGN.md §4.6): fixed left column (field + icon actions
    + static 6x6 keyboard generated in search_tab.cpp — no scroll),
    right area = history as chips + suggestions/results as a poster grid.
    720p height budget: 48 + 12 + 44 + 14 + (6x46 + 5x8) = 434
    for 617 usable (720 - footer 73 - paddingTop 30).
-->
<brls:Box
    width="auto"
    height="auto"
    paddingLeft="@style/main/content_padding_sides"
    paddingRight="@style/main/content_padding_sides"
    paddingTop="@style/main/content_padding_top_bottom">

    <!-- Fixed left column (~370 pt with the gutter) -->
    <brls:Box
        id="tv/search/left"
        axis="column"
        width="340"
        marginRight="30">

        <!-- Field: magnifier + typed text / placeholder; click = IME -->
        <brls:Box
            id="tv/search/box"
            focusable="true"
            height="48"
            alignItems="center"
            paddingLeft="14"
            paddingRight="14"
            cornerRadius="10"
            highlightCornerRadius="10"
            backgroundColor="@theme/color/grey_1">
            <SVGImage
                id="tv/search/svg"
                width="18"
                height="18"
                marginRight="10" />
            <brls:Label
                id="tv/search/input"
                grow="1"
                singleLine="true"
                fontSize="16" />
        </brls:Box>

        <!-- Icon actions: clear all / backspace / space / search -->
        <brls:Box
            id="tv/search/actions"
            height="44"
            marginTop="12">
            <brls:Box
                id="tv/search/action/clear"
                focusable="true"
                grow="1"
                alignItems="center"
                justifyContent="center"
                cornerRadius="8"
                highlightCornerRadius="8"
                backgroundColor="@theme/color/grey_2">
                <SVGImage
                    width="20"
                    height="20"
                    svg="@res/icon/ico-trash.svg" />
            </brls:Box>
            <brls:Box
                id="tv/search/action/delete"
                focusable="true"
                grow="1"
                marginLeft="8"
                alignItems="center"
                justifyContent="center"
                cornerRadius="8"
                highlightCornerRadius="8"
                backgroundColor="@theme/color/grey_2">
                <SVGImage
                    width="20"
                    height="20"
                    svg="@res/icon/ico-backspace.svg" />
            </brls:Box>
            <brls:Box
                id="tv/search/action/space"
                focusable="true"
                grow="1"
                marginLeft="8"
                alignItems="center"
                justifyContent="center"
                cornerRadius="8"
                highlightCornerRadius="8"
                backgroundColor="@theme/color/grey_2">
                <SVGImage
                    width="20"
                    height="20"
                    svg="@res/icon/ico-space.svg" />
            </brls:Box>
            <brls:Box
                id="tv/search/action/search"
                focusable="true"
                grow="1"
                marginLeft="8"
                alignItems="center"
                justifyContent="center"
                cornerRadius="8"
                highlightCornerRadius="8"
                backgroundColor="@theme/color/grey_2">
                <SVGImage
                    width="20"
                    height="20"
                    svg="@res/icon/ico-search.svg" />
            </brls:Box>
        </brls:Box>

        <!-- Static 6x6 keyboard (keys generated in code, no RecyclingGrid) -->
        <brls:Box
            id="tv/search/keyboard"
            axis="column"
            marginTop="14" />

    </brls:Box>

    <!-- Right area: history (chips) then suggestions / results -->
    <brls:Box
        id="tv/search/right"
        axis="column"
        grow="1">

        <brls:Box
            id="tv/history/box"
            axis="column">
            <brls:Header
                title="@i18n/main/search/history" />
            <brls:HScrollingFrame
                height="52"
                marginTop="2">
                <brls:Box
                    id="tv/search/history"
                    alignItems="center" />
            </brls:HScrollingFrame>
        </brls:Box>

        <brls:Header
            id="tv/search/section"
            marginTop="10"
            title="@i18n/main/search/suggest" />

        <RecyclingGrid
            id="tv/search/suggest"
            grow="1"
            marginTop="2"
            paddingBottom="@style/main/content_padding_top_bottom"
            itemHeight="@style/app/video/height"
            itemImageRatio="1.5"
            itemExtraHeight="55"
            spanCount="@style/app/grid/6" />

    </brls:Box>

</brls:Box>
