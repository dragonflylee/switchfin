<brls:Box
    width="auto"
    height="auto">

    <AutoTabFrame
        id="media/tabFrame"
        grow="1"
        defaultTab="0"
        tabHeight="60"
        tabJustifyContent="center"
        tabItemActiveTextColor="@theme/color/app"
        sidebarPosition="top">

        <Tab label="@i18n/main/tabs/home"
            fontSize="18">
            <!-- insets carried by the grid (padding inside the scroll):
                 the posters slide up to the edges of the area.
                 paddingTop 70: the tab bar (60) floats above the grid,
                 which scrolls beneath -->
            <RecyclingGrid
                grow="1"
                wireframe="false"
                paddingTop="70"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                paddingBottom="@style/main/content_padding_top_bottom"
                spanCount="@style/app/grid/6"
                itemHeight="@style/app/video/height"
                itemImageRatio="1.5"
                itemExtraHeight="55"
                id="media/series" />
        </Tab>
    </AutoTabFrame>

</brls:Box>
