<brls:Box
    width="auto"
    height="auto">

    <!-- insets inside the scroll: cards up to the edges (collection.xml pattern).
         Square cards: Plex composite = 1:1 mosaic -->
    <RecyclingGrid
        grow="1"
        wireframe="false"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="@style/main/content_padding_sides"
        paddingTop="@style/main/content_padding_top_bottom"
        paddingBottom="@style/main/content_padding_top_bottom"
        spanCount="@style/app/grid/5"
        itemHeight="@style/app/video/height"
        itemImageRatio="1.0"
        itemExtraHeight="55"
        id="playlists/grid" />

</brls:Box>
