<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        grow="1.0">

        <brls:Box
            axis="column"
            paddingLeft="@style/main/content_padding_sides"
            paddingRight="@style/main/content_padding_sides"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

            <brls:Box
                id="movie/banner"
                width="100%"
                height="260"
                visibility="gone">
                <brls:Image
                    id="movie/image/backdrop"
                    width="100%"
                    height="100%"
                    scalingType="fill"
                    cornerRadius="4"
                    backgroundColor="@theme/color/grey_1" />
                <brls:Box
                    positionType="absolute"
                    positionTop="0"
                    positionLeft="0"
                    width="100%"
                    height="100%"
                    alignItems="center"
                    justifyContent="center">
                    <brls:Image
                        id="movie/image/logo"
                        width="440"
                        height="130"
                        scalingType="fit" />
                </brls:Box>
            </brls:Box>

            <brls:Box
                id="movie/content/row">

                <brls:Box
                    width="220"
                    axis="column"
                    marginRight="30">
                    <brls:Image
                        id="movie/image/poster"
                        height="330"
                        scalingType="fill"
                        cornerRadius="4"
                        backgroundColor="@theme/color/grey_1"
                        image="@res/img/video-card-bg.png" />

                    <brls:SelectorCell
                        id="movie/source"
                        visibility="gone"
                        height="40"
                        marginTop="20px" />

                    <brls:Button
                        id="movie/play"
                        height="50"
                        marginTop="10px"
                        text="@i18n/main/media/play" />

                    <brls:Button
                        id="movie/download"
                        height="50"
                        marginTop="10px"
                        style="bordered"
                        text="@i18n/main/download/start" />
                </brls:Box>

                <brls:Box
                    id="movie/content/info"
                    axis="column"
                    grow="1.0"
                    paddingRight="@style/main/content_padding_sides">

                    <brls:Header
                        marginBottom="10"
                        height="40"
                        id="movie/header/title" />

                    <brls:Box
                        alignItems="center"
                        marginBottom="10">

                        <brls:Label
                            id="movie/label/genres"
                            fontSize="15"
                            animated="false"
                            marginBottom="15" />

                        <brls:Padding />

                        <brls:Label
                            id="movie/label/year"
                            marginRight="10"
                            fontSize="15" />

                        <brls:Box
                            wireframe="false"
                            borderColor="@theme/brls/text"
                            borderThickness="1"
                            visibility="gone"
                            paddingLeft="5"
                            paddingRight="5"
                            height="30"
                            marginRight="10">
                            <brls:Label
                                id="movie/parental/rating"
                                singleLine="true"
                                wireframe="false"
                                fontSize="15" />
                        </brls:Box>

                        <brls:Box
                            wireframe="false"
                            alignItems="center"
                            visibility="gone">
                            <SVGImage
                                width="15"
                                height="15"
                                svg="@res/icon/ico-star.svg" />
                            <brls:Label
                                id="movie/label/rating"
                                marginLeft="2"
                                fontSize="15" />
                        </brls:Box>
                    </brls:Box>

                    <TextBox
                        id="movie/label/overview"
                        fontSize="15"
                        textColor="@theme/font/grey" />

                    <brls:Header
                        height="40"
                        id="movie/label/people"
                        title="@i18n/main/media/people" />

                    <HRecyclerFrame
                        height="250"
                        itemWidth="140"
                        id="movie/people" />

                    <brls:Box
                        id="movie/related/box"
                        axis="column" />

                </brls:Box>
            </brls:Box>

        </brls:Box>

    </brls:ScrollingFrame>
</brls:Box>
