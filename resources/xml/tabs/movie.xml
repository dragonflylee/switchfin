<brls:Box
    width="auto"
    height="auto">

    <!-- centered: the scroll follows the D-pad focus (buttons -> cast -> rows) -->
    <brls:ScrollingFrame
        grow="1.0"
        scrollingBehavior="centered">

        <brls:Box
            axis="column"
            paddingBottom="@style/main/content_padding_top_bottom">

            <!-- full-bleed banner: backdrop + fade towards the background +
                 logo nested at the bottom of the fade (readable in the shadow).
                 NB: keep a cornerRadius on brls:Image with scalingType="fill",
                 it is what enables the render clip (otherwise the image overflows). -->
            <brls:Box
                id="movie/banner"
                width="100%"
                height="320">
                <brls:Image
                    id="movie/image/backdrop"
                    width="100%"
                    height="100%"
                    scalingType="fill"
                    cornerRadius="4"
                    backgroundColor="@theme/color/grey_1" />
                <brls:Image
                    id="movie/banner/fade"
                    positionType="absolute"
                    positionBottom="0"
                    positionLeft="0"
                    width="100%"
                    height="260"
                    scalingType="stretch"
                    image="@res/img/fade-bottom-dark.png" />
                <brls:Box
                    positionType="absolute"
                    positionBottom="26"
                    positionLeft="0"
                    width="100%"
                    justifyContent="center">
                    <brls:Image
                        id="movie/image/logo"
                        width="440"
                        height="120"
                        scalingType="fit" />
                </brls:Box>
            </brls:Box>

            <!-- only the poster overlaps the banner; the info column
                 (title, pills, genres, buttons, synopsis) starts BELOW the
                 banner: no more text over the backdrop -->
            <brls:Box
                id="movie/content/row"
                marginTop="-150"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides">

                <!-- 64: the poster only rises ~86 px into the banner
                     (poster lowered, info column unchanged) -->
                <brls:Box
                    width="220"
                    axis="column"
                    marginTop="64"
                    marginRight="34">
                    <!-- poster over a grey_1 box with a media-icon placeholder
                         BEHIND it (same pattern as video_card.xml): a missing
                         poster shows the icon, not a bare dark rectangle. The
                         image is transparent until loaded, then covers it. -->
                    <brls:Box
                        height="330"
                        cornerRadius="10"
                        backgroundColor="@theme/color/grey_1">
                        <brls:Box
                            positionType="absolute"
                            positionTop="0"
                            positionLeft="0"
                            width="100%"
                            height="100%"
                            alignItems="center"
                            justifyContent="center">
                            <SVGImage
                                width="48"
                                height="48"
                                svg="@res/icon/ico-media.svg" />
                        </brls:Box>
                        <brls:Image
                            id="movie/image/poster"
                            width="100%"
                            height="330"
                            scalingType="fill"
                            cornerRadius="10" />
                    </brls:Box>

                    <brls:SelectorCell
                        id="movie/source"
                        visibility="gone"
                        height="40"
                        marginTop="20px" />
                </brls:Box>

                <!-- 184 = 150 of banner overlap + ~34 px of air between the
                     bottom of the banner and the top of the title -->
                <brls:Box
                    id="movie/content/info"
                    axis="column"
                    marginTop="184"
                    grow="1.0">

                    <brls:Label
                        id="movie/label/title"
                        fontSize="42"
                        marginBottom="14" />

                    <brls:Box
                        alignItems="center"
                        marginBottom="14">

                        <brls:Box
                            cornerRadius="14"
                            height="28"
                            alignItems="center"
                            paddingLeft="12"
                            paddingRight="12"
                            marginRight="8"
                            backgroundColor="@theme/color/pill">
                            <brls:Label
                                id="movie/label/year"
                                singleLine="true"
                                fontSize="14" />
                        </brls:Box>

                        <brls:Box
                            cornerRadius="14"
                            height="28"
                            alignItems="center"
                            paddingLeft="12"
                            paddingRight="12"
                            marginRight="8"
                            visibility="gone"
                            backgroundColor="@theme/color/pill">
                            <brls:Label
                                id="movie/parental/rating"
                                singleLine="true"
                                fontSize="14" />
                        </brls:Box>

                        <!-- critic rating: official source icon (RT tomato /
                             IMDb / TMDb) set at runtime, generic star fallback.
                             Icon width is sized to the glyph aspect in C++. -->
                        <brls:Box
                            cornerRadius="14"
                            height="28"
                            alignItems="center"
                            paddingLeft="12"
                            paddingRight="12"
                            marginRight="8"
                            visibility="gone"
                            backgroundColor="@theme/color/pill">
                            <SVGImage
                                id="movie/rating/icon"
                                width="15"
                                height="15"
                                marginRight="5"
                                svg="@res/icon/ico-star.svg" />
                            <brls:Label
                                id="movie/label/rating"
                                singleLine="true"
                                fontSize="14" />
                        </brls:Box>

                        <!-- audience rating: RT popcorn (upright/spilled) -->
                        <brls:Box
                            cornerRadius="14"
                            height="28"
                            alignItems="center"
                            paddingLeft="12"
                            paddingRight="12"
                            visibility="gone"
                            backgroundColor="@theme/color/pill">
                            <SVGImage
                                id="movie/audience/icon"
                                width="15"
                                height="15"
                                marginRight="5"
                                svg="@res/icon/rating/rt_upright.svg" />
                            <brls:Label
                                id="movie/label/audience"
                                singleLine="true"
                                fontSize="14" />
                        </brls:Box>
                    </brls:Box>

                    <brls:Label
                        id="movie/label/genres"
                        fontSize="14"
                        animated="false"
                        textColor="@theme/font/grey"
                        marginBottom="16" />

                    <!-- inline buttons under the genres, before the synopsis;
                         dark icons on the gold primary. marginTop sets the
                         action row apart from the title/meta block above
                         (genres only carry a 16 bottom margin) -->
                    <brls:Box
                        id="movie/buttons"
                        axis="row"
                        marginTop="16"
                        marginBottom="18">

                        <IconButton
                            id="movie/play"
                            icon="@res/icon/ico-play-dark.svg"
                            text="@i18n/main/media/play"
                            buttonStyle="primary" />

                        <IconButton
                            id="movie/download"
                            icon="@res/icon/ico-download-light.svg"
                            text="@i18n/main/download/start"
                            buttonStyle="bordered"
                            marginLeft="12" />

                        <!-- revealed once the watchlist state is known (async
                             provider request, media_movie.cpp); filled icon
                             = already in the Watchlist -->
                        <IconButton
                            id="movie/watchlist"
                            icon="@res/icon/ico-bookmark-light.svg"
                            text="@i18n/main/watchlist/title"
                            buttonStyle="bordered"
                            visibility="gone"
                            marginLeft="12" />
                    </brls:Box>

                    <TextBox
                        id="movie/label/overview"
                        fontSize="15"
                        textColor="@theme/font/grey" />

                </brls:Box>
            </brls:Box>

            <!-- full-width rows under the poster block: insets inside the
                 scroll, the cards slide up to the edges;
                 ~28 between the end of a row and the next Header -->
            <brls:Header
                marginTop="28"
                marginBottom="6"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides"
                id="movie/label/people"
                title="@i18n/main/media/people" />

            <HRecyclerFrame
                height="250"
                itemWidth="140"
                itemSpace="18"
                marginBottom="28"
                paddingLeft="@style/main/content_padding_sides"
                paddingRight="@style/main/content_padding_sides"
                id="movie/people" />

            <brls:Box
                id="movie/related/box"
                axis="column" />

        </brls:Box>

    </brls:ScrollingFrame>
</brls:Box>
