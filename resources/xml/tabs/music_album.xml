<brls:Box
    width="auto"
    height="auto"
    paddingLeft="@style/main/content_padding_sides"
    paddingRight="@style/main/content_padding_sides"
    paddingTop="@style/main/content_padding_top_bottom"
    paddingBottom="@style/main/content_padding_top_bottom">

    <brls:Box
        axis="column"
        padding="5"
        width="300"
        borderColor="@theme/brls/text">

        <brls:Box
            width="100%"
            axis="column"
            alignItems="center"
            paddingTop="15"
            paddingBottom="10">

            <brls:Image
                id="album/image/cover"
                scalingType="fit"
                width="240"
                height="240"
                marginBottom="15"
                backgroundColor="@theme/brls/header/border"
                image="@res/img/video-card-bg.png" />

            <brls:Label
                fontSize="22"
                wireframe="false"
                singleLine="true"
                id="album/label/title" />
            <brls:Label
                fontSize="16"
                marginTop="8"
                id="album/label/artist" />
            <brls:Label
                id="album/label/year"
                fontSize="13"
                singleLine="true"
                textColor="@theme/font/grey"
                marginTop="8" />

            <brls:Box
                id="album/stats/row"
                axis="column"
                alignItems="center"
                marginTop="8">

                <brls:Box
                    id="album/tracks/count"
                    cornerRadius="14"
                    height="26"
                    alignItems="center"
                    paddingLeft="10"
                    paddingRight="10"
                    marginBottom="6"
                    visibility="gone"
                    backgroundColor="@theme/color/pill">
                    <brls:Label
                        id="album/label/tracks"
                        singleLine="true"
                        fontSize="13" />
                </brls:Box>

                <brls:Box
                    id="album/duration"
                    cornerRadius="14"
                    height="26"
                    alignItems="center"
                    paddingLeft="10"
                    paddingRight="10"
                    marginBottom="6"
                    visibility="gone"
                    backgroundColor="@theme/color/pill">
                    <brls:Label
                        id="album/label/duration"
                        singleLine="true"
                        fontSize="13" />
                </brls:Box>
            </brls:Box>

            <brls:Label
                id="album/label/genres"
                fontSize="13"
                animated="false"
                singleLine="true"
                textColor="@theme/font/grey"
                visibility="gone"
                marginTop="6" />
        </brls:Box>

        <brls:Padding />

        <brls:Box
            id="album/stats" />
    </brls:Box>

    <RecyclingGrid
        grow="1"
        wireframe="false"
        paddingLeft="30"
        paddingRight="30"
        spanCount="1"
        flowMode="true"
        itemSpace="5"
        id="album/tracks"
        focusable="true" />

</brls:Box>