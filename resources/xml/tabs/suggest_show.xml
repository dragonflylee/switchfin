<brls:Box
    width="auto"
    height="auto">

    <!-- centered: the focus jumps row to row, the scroll follows — the
         natural mode (default) scrolled pixel by pixel on hold and stole
         the focus as soon as the card left the frame (focus lost on the
         tab bar translated off-screen) -->
    <brls:ScrollingFrame
        width="auto"
        height="auto"
        grow="1.0"
        scrollingBehavior="centered">

        <!-- paddingTop 70: inside the scroll, the rows start under the
             library's floating tab bar (60) -->
        <brls:Box
            axis="column"
            paddingTop="70"
            id="suggest/box" />

    </brls:ScrollingFrame>

</brls:Box>