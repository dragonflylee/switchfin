<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- EVERYTHING scrolls (header included: first cell of the flow);
         paddings INSIDE the scroll: the content goes up to the edges (full-bleed) -->
    <RecyclingGrid
        grow="1"
        wireframe="false"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="@style/main/content_padding_sides"
        paddingTop="@style/main/content_padding_top_bottom"
        paddingBottom="@style/main/content_padding_top_bottom"
        spanCount="1"
        flowMode="true"
        itemSpace="10"
        id="media/episodes" />

</brls:Box>
