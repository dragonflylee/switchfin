<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- full page of a hub ("+" card of the related rows): EVERYTHING
         scrolls, the header (title + "N items") is a scrolled view of
         the grid (setHeaderView); insets inside the scroll -->
    <RecyclingGrid
        grow="1"
        wireframe="false"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="@style/main/content_padding_sides"
        paddingTop="@style/main/content_padding_top_bottom"
        paddingBottom="@style/main/content_padding_top_bottom"
        spanCount="@style/app/grid/6"
        itemHeight="@style/app/video/height"
        itemImageRatio="1.5"
        itemExtraHeight="55"
        id="hub/items" />

    <ButtonClose
        id="hub/close"
        positionType="absolute"
        positionTop="10"
        positionRight="10" />

</brls:Box>
