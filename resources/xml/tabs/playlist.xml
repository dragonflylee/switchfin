<brls:Box
    width="auto"
    height="auto"
    axis="column">

    <!-- TOUT défile : l'en-tête (titre + « N éléments · durée ») est une vue
         scrollée de la grille (setHeaderView) ; retraits internes au scroll,
         affiches jusqu'aux bords (pattern collection.xml) -->
    <RecyclingGrid
        grow="1"
        wireframe="false"
        paddingLeft="@style/main/content_padding_sides"
        paddingRight="@style/main/content_padding_sides"
        paddingTop="@style/main/content_padding_top_bottom"
        paddingBottom="@style/main/content_padding_top_bottom"
        spanCount="@style/app/grid/6"
        itemHeight="@style/app/video/height"
        itemImageRatio="1.5"
        itemExtraHeight="55"
        id="playlist/items" />

    <ButtonClose
        id="playlist/close"
        positionType="absolute"
        positionTop="10"
        positionRight="10" />

</brls:Box>
