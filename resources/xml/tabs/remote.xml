<brls:Box
    width="auto"
    height="auto"
    paddingLeft="5"
    paddingRight="5">

    <!-- same style as the library bars (collection.xml):
         height 60, centered pills, floating bar above the content -->
    <AutoTabFrame
        id="remote/tabFrame"
        grow="1"
        defaultTab="0"
        tabHeight="60"
        tabJustifyContent="center"
        tabItemActiveTextColor="@theme/color/app"
        sidebarPosition="top">

    </AutoTabFrame>
</brls:Box>