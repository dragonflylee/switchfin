<!-- Logged-out root: hosts the ConnectionSwitcher grid (added in C++). When
     connected, the switcher is shown as a detail over the app instead. -->
<brls:AppletFrame
    id="server/frame"
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">

    <brls:Box
        id="switcher/content"
        width="100%"
        height="100%"
        axis="column" />

</brls:AppletFrame>
