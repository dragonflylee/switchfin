<!-- Loading overlay: a dimmed scrim (brls/backdrop) over the screen the user
     was on, with a centered surface card. The card holds the spinner + the
     "Connecting…" label; the hint below it starts hidden and is revealed by
     LoadingOverlay's slowTimer if the wait runs long. -->
<brls:Box
    width="100%"
    height="100%"
    axis="column"
    justifyContent="center"
    alignItems="center"
    backgroundColor="@theme/brls/backdrop">

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        justifyContent="center"
        paddingTop="32"
        paddingBottom="32"
        paddingLeft="56"
        paddingRight="56"
        cornerRadius="14"
        backgroundColor="@theme/color/surface">

        <brls:ProgressSpinner
            width="56"
            height="56"
            marginBottom="20" />

        <brls:Label
            fontSize="17"
            horizontalAlign="center"
            text="@i18n/main/plex/connecting" />

        <!-- Revealed by LoadingOverlay::slowTimer (loading_overlay.cpp) only
             when the connection is taking longer than usual. -->
        <brls:Label
            id="loading/hint"
            width="380"
            fontSize="14"
            marginTop="12"
            textColor="@theme/font/grey"
            horizontalAlign="center"
            visibility="gone"
            text="@i18n/main/plex/connecting_slow" />

    </brls:Box>
</brls:Box>
