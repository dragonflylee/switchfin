<brls:AppletFrame
    id="main/frame"
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">
    <brls:Box
        axis="column"
        width="100%"
        height="100%">
        <MainTabFrame
            id="main/tabFrame"
            grow="1"
            tabBackgroundColor="@theme/color/grey_1"
            tabItemActiveTextColor="@theme/color/app"
            defaultTab="0"
            sidebarPosition="left">

            <Tab label=""
                fontSize="18"
                icon="@res/icon/ico-home.svg"
                iconActivate="@res/icon/ico-home-activate.svg">
                <HomeTab />
            </Tab>

            <Tab label=""
                fontSize="18"
                icon="@res/icon/ico-search.svg"
                iconActivate="@res/icon/ico-search-activate.svg">
                <SearchTab />
            </Tab>

            <Tab label=""
                fontSize="18"
                id="tab/playlists"
                icon="@res/icon/ico-playlist.svg"
                iconActivate="@res/icon/ico-playlist-activate.svg">
                <PlaylistsTab />
            </Tab>

            <Tab label=""
                fontSize="18"
                id="tab/watchlist"
                icon="@res/icon/ico-bookmark-fill.svg"
                iconActivate="@res/icon/ico-bookmark-fill-activate.svg">
                <WatchlistTab />
            </Tab>

            <Tab label=""
                fontSize="18"
                id="tab/remote"
                icon="@res/icon/ico-download.svg"
                iconActivate="@res/icon/ico-download-activate.svg">
                <RemoteTab />
            </Tab>

            <Tab label=""
                fontSize="18"
                icon="@res/icon/ico-setting.svg"
                iconActivate="@res/icon/ico-setting-activate.svg">
                <SettingTab />
            </Tab>

        </MainTabFrame>
    </brls:Box>
</brls:AppletFrame>