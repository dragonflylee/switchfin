<brls:Box
    width="auto"
    height="auto"
    axis="row"
    backgroundColor="@theme/brls/background">

    <!-- LEFT pane: cover + title/artist + progress + transport, centered -->
    <brls:Box
        grow="1"
        axis="column"
        alignItems="center"
        justifyContent="center">

        <brls:Box
            width="300"
            height="300"
            cornerRadius="14"
            backgroundColor="@theme/color/grey_1"
            alignItems="center"
            justifyContent="center">
            <!-- note placeholder shown through the (transparent) cover when no art -->
            <SVGImage width="80" height="80" svg="@res/icon/ico-audio.svg" />
            <brls:Image
                id="musicnp/cover"
                positionType="absolute"
                positionTop="0"
                positionLeft="0"
                width="100%"
                height="100%"
                cornerRadius="14"
                scalingType="fill" />
        </brls:Box>

        <brls:Label
            id="musicnp/title"
            marginTop="28"
            singleLine="true"
            horizontalAlign="center"
            fontSize="26" />

        <brls:Label
            id="musicnp/artist"
            marginTop="8"
            singleLine="true"
            horizontalAlign="center"
            fontSize="17"
            textColor="@theme/font/grey" />

        <brls:Box
            width="560"
            marginTop="28"
            axis="column">
            <VideoProgressSlider
                focusable="true"
                id="musicnp/progress"
                width="100%"
                height="10"
                pointer="10" />
            <brls:Box
                width="100%"
                marginTop="6"
                justifyContent="spaceBetween">
                <brls:Label id="musicnp/left" fontSize="14" text="--:--" textColor="@theme/font/grey" />
                <brls:Label id="musicnp/right" fontSize="14" text="--:--" textColor="@theme/font/grey" />
            </brls:Box>
        </brls:Box>

        <brls:Box
            width="560"
            marginTop="22"
            alignItems="center"
            justifyContent="spaceAround">

            <brls:Box
                id="musicnp/shuffle"
                focusable="true"
                hideHighlightBackground="true"
                highlightCornerRadius="100"
                cornerRadius="100"
                borderColor="@theme/font/grey"
                alignItems="center"
                justifyContent="center"
                height="48"
                width="48">
                <SVGImage id="musicnp/shuffle/icon" height="30" width="30" svg="@res/icon/ico-shuffle.svg" />
            </brls:Box>

            <brls:Box
                id="musicnp/prev"
                focusable="true"
                hideHighlightBackground="true"
                highlightCornerRadius="100"
                alignItems="center"
                justifyContent="center"
                height="48"
                width="48">
                <SVGImage height="34" width="34" svg="@res/icon/ico-backward.svg" />
            </brls:Box>

            <brls:Box
                id="musicnp/toggle"
                focusable="true"
                hideHighlightBackground="true"
                highlightCornerRadius="100"
                alignItems="center"
                justifyContent="center"
                height="60"
                width="60">
                <SVGImage id="musicnp/toggle/icon" height="44" width="44" svg="@res/icon/ico-play.svg" />
            </brls:Box>

            <brls:Box
                id="musicnp/next"
                focusable="true"
                hideHighlightBackground="true"
                highlightCornerRadius="100"
                alignItems="center"
                justifyContent="center"
                height="48"
                width="48">
                <SVGImage height="34" width="34" svg="@res/icon/ico-forward.svg" />
            </brls:Box>

            <brls:Box
                id="musicnp/repeat"
                focusable="true"
                hideHighlightBackground="true"
                highlightCornerRadius="100"
                cornerRadius="100"
                borderColor="@theme/font/grey"
                alignItems="center"
                justifyContent="center"
                height="48"
                width="48">
                <SVGImage id="musicnp/repeat/icon" height="30" width="30" svg="@res/icon/ico-playlist.svg" />
            </brls:Box>
        </brls:Box>

    </brls:Box>

    <!-- RIGHT pane: the play queue (visible, selectable, reorderable) -->
    <brls:Box
        width="440"
        axis="column"
        paddingTop="64"
        paddingBottom="40"
        paddingLeft="12"
        paddingRight="40">
        <brls:Label
            marginLeft="6"
            marginBottom="14"
            fontSize="22"
            text="@i18n/main/music/queue"/>
        <RecyclingGrid
            id="musicnp/queue"
            grow="1"
            wireframe="false"
            spanCount="1"
            flowMode="true"
            itemSpace="4" />
    </brls:Box>

</brls:Box>
