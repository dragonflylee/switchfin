<brls:Box
    highlightCornerRadius="14"
    axis="column"
    width="auto"
    height="auto">
    <!-- background + placeholder icon BEHIND the image: visible while no
         poster is loaded, covered by the texture otherwise -->
    <brls:Box
        id="video/card/pic_box"
        axis="row"
        focusable="true"
        highlightCornerRadius="14"
        cornerRadius="10"
        backgroundColor="@theme/color/grey_1"
        grow="1">

        <brls:Box
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="100%"
            height="100%"
            alignItems="center"
            justifyContent="center">
            <SVGImage
                width="40"
                height="40"
                svg="@res/icon/ico-media.svg" />
        </brls:Box>

        <brls:Image
            id="video/card/picture"
            grow="1"
            scalingType="fill"
            cornerRadius="10" />

        <SVGImage
            id="video/card/badge/top"
            positionType="absolute"
            positionTop="8"
            positionRight="8"
            height="24" />

        <brls:Box
            positionType="absolute"
            positionBottom="8"
            width="100%"
            paddingLeft="10"
            paddingRight="10">
            <brls:Box
                id="video/card/progress_track"
                visibility="gone"
                grow="1"
                height="4"
                cornerRadius="2"
                backgroundColor="@theme/color/scrim">
                <brls:Rectangle
                    id="video/card/progress"
                    height="4"
                    cornerRadius="2"
                    width="50%"
                    color="@theme/color/app" />
            </brls:Box>
        </brls:Box>

    </brls:Box>

    <brls:Box
        axis="column"
        marginTop="10"
        justifyContent="spaceEvenly"
        alignItems="center">
        <brls:Label
            wireframe="false"
            singleLine="true"
            id="video/card/label/title"
            height="25"
            fontSize="18" />
        <brls:Label
            wireframe="false"
            singleLine="true"
            id="video/card/label/ext"
            fontSize="12"
            height="20"
            textColor="@theme/font/grey" />
    </brls:Box>

</brls:Box>