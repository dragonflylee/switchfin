<brls:Box
    highlightCornerRadius="12"
    padding="5">

    <brls:Box
        axis="row"
        width="300"
        alignItems="center">
        <!-- same contract as video_card.xml: BaseCardCell::getDefaultFocus()
             returns this box to limit the focus halo to the thumbnail -->
        <brls:Box
            id="video/card/pic_box"
            focusable="true"
            highlightCornerRadius="12"
            cornerRadius="8"
            backgroundColor="@theme/color/grey_1">

            <!-- placeholder icon behind the thumbnail (cf. video_card.xml) -->
            <brls:Box
                positionType="absolute"
                positionTop="0"
                positionLeft="0"
                width="100%"
                height="100%"
                alignItems="center"
                justifyContent="center">
                <SVGImage
                    width="36"
                    height="36"
                    svg="@res/icon/ico-media.svg" />
            </brls:Box>

            <brls:Image
                id="video/card/picture"
                scalingType="fill"
                height="180"
                cornerRadius="8" />

            <SVGImage
                id="video/card/badge/top"
                positionType="absolute"
                positionTop="8"
                positionRight="8"
                height="24" />

            <brls:Box
                wireframe="false"
                positionType="absolute"
                positionBottom="0"
                visibility="gone"
                width="100%"
                height="2"
                backgroundColor="#353535">
                <brls:Rectangle
                    id="video/card/progress"
                    height="2"
                    width="50%"
                    color="@theme/color/app" />
            </brls:Box>
        </brls:Box>
    </brls:Box>

    <brls:Box
        axis="column"
        marginLeft="20">
        <brls:Label
            id="episode/card/name"
            margin="10"
            singleLine="true"
            fontSize="18" />

        <TextBox
            id="episode/card/overview"
            grow="1"
            fontSize="15"
            maxRows="6"
            textColor="@theme/font/grey" />
    </brls:Box>

</brls:Box>