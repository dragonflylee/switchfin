<!-- scrolled header of a full-page grid (RecyclingGrid::setHeaderView):
     title + meta line — shared by the playlist view and the hub page -->
<brls:Box
    axis="column"
    justifyContent="flexStart">

    <brls:Label
        id="grid/header/title"
        fontSize="30" />

    <brls:Label
        id="grid/header/meta"
        fontSize="15"
        marginTop="6"
        textColor="@theme/font/grey" />

</brls:Box>
