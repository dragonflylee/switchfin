<!-- Track row (BaseCardCell contract: the required video/card/* ids are present
     so the shared focus/ticker/long-press machinery binds cleanly). Compact
     row: [cover] [n°] [title ...............] [duration]. -->
<brls:Box
    highlightCornerRadius="12"
    padding="5"
    axis="row"
    alignItems="center">

    <brls:Box
        id="video/card/pic_box"
        focusable="true"
        width="46"
        height="46"
        highlightCornerRadius="8"
        cornerRadius="8"
        alignItems="center"
        justifyContent="center"
        backgroundColor="@theme/color/grey_1">

        <SVGImage width="22" height="22" svg="@res/icon/ico-audio.svg" />

        <brls:Image
            id="video/card/picture"
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            scalingType="fill"
            width="100%"
            height="100%"
            cornerRadius="8" />
    </brls:Box>

    <brls:Label
        id="track/row/index"
        width="40"
        marginLeft="14"
        fontSize="16"
        horizontalAlign="center"
        textColor="@theme/font/grey" />

    <brls:Box
        axis="column"
        grow="1"
        marginLeft="4"
        justifyContent="center">
        <brls:Label
            id="video/card/label/title"
            singleLine="true"
            fontSize="17" />
    </brls:Box>

    <brls:Label
        id="video/card/label/ext"
        marginLeft="10"
        fontSize="15"
        textColor="@theme/font/grey" />

</brls:Box>
