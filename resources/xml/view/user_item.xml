<brls:Box
    highlightCornerRadius="16"
    axis="column"
    justifyContent="center"
    width="auto"
    height="auto">
    <brls:Box
        id="video/card/pic_box"
        axis="row"
        width="100%"
        padding="10"
        justifyContent="center">
        <!-- circular avatar (cornerRadius = half the side), consistent with the
             cast/person photos (people.xml). cornerRadius is also what clips the
             scalingType="fill" render. Square box -> perfect circle. -->
        <brls:Image
            id="user/avatar"
            width="120"
            height="120"
            backgroundColor="@theme/color/grey_1"
            scalingType="fill"
            image="@res/img/account.png"
            cornerRadius="60" />
    </brls:Box>

    <brls:Box
        axis="column"
        alignItems="center">
        <brls:Label
            wireframe="false"
            id="user/name"
            fontSize="18" />
    </brls:Box>
</brls:Box>