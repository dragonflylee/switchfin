<!-- Offline empty state: icon + title + message + focusable "Retry" button
     (reconnects to the server). Shown on the offline home when nothing is
     downloaded (SPEC §4.4). -->
<brls:Box
    axis="column"
    grow="1"
    justifyContent="center"
    alignItems="center"
    paddingLeft="40"
    paddingRight="40">

    <SVGImage
        width="72"
        height="72"
        svg="@res/icon/ico-cloud.svg"
        marginBottom="24" />

    <brls:Label
        id="offline/empty/title"
        text="@i18n/main/download/offline_title"
        width="460"
        fontSize="24"
        horizontalAlign="center"
        marginBottom="10" />

    <brls:Label
        id="offline/empty/sub"
        text="@i18n/main/download/offline_sub"
        width="460"
        fontSize="16"
        horizontalAlign="center"
        textColor="@theme/font/grey"
        marginBottom="28" />

    <IconButton
        id="offline/empty/retry"
        icon="@res/icon/ico-download-light.svg"
        text="@i18n/main/download/offline_retry"
        buttonStyle="primary" />

</brls:Box>
