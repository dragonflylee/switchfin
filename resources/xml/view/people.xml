<brls:Box
    width="auto"
    height="auto">

    <!-- the whole page scrolls (header included): centered, the scroll follows the focus -->
    <brls:ScrollingFrame
        grow="1.0"
        scrollingBehavior="centered">

        <brls:Box
            axis="column"
            paddingTop="@style/main/content_padding_top_bottom"
            paddingBottom="@style/main/content_padding_top_bottom">

            <brls:Box
                height="220"
                marginLeft="@style/main/content_padding_sides"
                marginRight="@style/main/content_padding_sides"
                marginBottom="30"
                alignItems="center">

                <brls:Image
                    id="people/image/photo"
                    width="220"
                    height="220"
                    cornerRadius="110"
                    scalingType="fill"
                    backgroundColor="@theme/color/grey_1"
                    image="@res/img/video-card-bg.png" />

                <brls:Box
                    axis="column"
                    grow="1.0"
                    marginLeft="34"
                    justifyContent="center">

                    <brls:Label
                        id="people/label/name"
                        fontSize="34" />

                    <brls:Label
                        id="people/label/role"
                        fontSize="18"
                        marginTop="8"
                        visibility="gone"
                        textColor="@theme/font/grey" />

                    <brls:Box
                        id="people/box/counts"
                        marginTop="18">

                        <brls:Box
                            id="people/pill/movies"
                            visibility="gone"
                            cornerRadius="14"
                            height="28"
                            paddingLeft="14"
                            paddingRight="14"
                            marginRight="10"
                            alignItems="center"
                            backgroundColor="@theme/color/pill">
                            <brls:Label
                                id="people/label/movies"
                                fontSize="15" />
                        </brls:Box>

                        <brls:Box
                            id="people/pill/shows"
                            visibility="gone"
                            cornerRadius="14"
                            height="28"
                            paddingLeft="14"
                            paddingRight="14"
                            alignItems="center"
                            backgroundColor="@theme/color/pill">
                            <brls:Label
                                id="people/label/shows"
                                fontSize="15" />
                        </brls:Box>

                    </brls:Box>

                </brls:Box>

            </brls:Box>

            <RecylingVideo
                nextPage="auto"
                frameHeight="@style/app/card/poster/row"
                itemWidth="@style/app/card/poster/width"
                sidePadding="@style/main/content_padding_sides"
                id="people/movie"
                title="@i18n/main/person/movies" />

            <RecylingVideo
                nextPage="auto"
                frameHeight="@style/app/card/poster/row"
                itemWidth="@style/app/card/poster/width"
                sidePadding="@style/main/content_padding_sides"
                id="people/series"
                title="@i18n/main/person/shows" />

        </brls:Box>

    </brls:ScrollingFrame>
</brls:Box>
