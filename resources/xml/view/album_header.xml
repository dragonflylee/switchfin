<brls:Box
    axis="row"
    paddingBottom="16">

    <brls:Box
        width="225"
        height="225"
        cornerRadius="10"
        backgroundColor="@theme/color/grey_1"
        alignItems="center"
        justifyContent="center">
        <SVGImage width="64" height="64" svg="@res/icon/ico-audio.svg" />
        <brls:Image
            id="album/image/cover"
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="100%"
            height="100%"
            cornerRadius="10"
            scalingType="fill" />
    </brls:Box>

    <brls:Box
        axis="column"
        grow="1.0"
        marginLeft="24"
        justifyContent="center">

        <brls:Label
            id="album/label/title"
            fontSize="26" />

        <brls:Label
            id="album/label/meta"
            fontSize="15"
            marginTop="8"
            textColor="@theme/font/grey" />

        <brls:Box marginTop="14">
            <IconButton
                id="album/play"
                icon="@res/icon/ico-play.svg"
                text="@i18n/main/music/play_album"
                buttonStyle="primary" />
        </brls:Box>

    </brls:Box>
</brls:Box>
