<brls:Box
    axis="row"
    paddingBottom="16">

    <!-- poster over a grey_1 box with a media-icon placeholder BEHIND it
         (same pattern as video_card.xml): a missing poster shows the icon,
         not a bare grey rectangle. Image transparent until loaded. -->
    <brls:Box
        width="150"
        height="225"
        cornerRadius="10"
        backgroundColor="@theme/color/grey_1">
        <brls:Box
            positionType="absolute"
            positionTop="0"
            positionLeft="0"
            width="100%"
            height="100%"
            alignItems="center"
            justifyContent="center">
            <SVGImage
                width="40"
                height="40"
                svg="@res/icon/ico-media.svg" />
        </brls:Box>
        <brls:Image
            id="season/image/poster"
            width="150"
            height="225"
            scalingType="fill"
            cornerRadius="10" />
    </brls:Box>

    <brls:Box
        axis="column"
        grow="1.0"
        marginLeft="24"
        justifyContent="center">

        <brls:Label
            id="season/label/title"
            fontSize="26" />

        <brls:Label
            id="season/label/meta"
            fontSize="15"
            marginTop="8"
            textColor="@theme/font/grey" />

        <TextBox
            id="season/label/overview"
            fontSize="14"
            maxRows="4"
            marginTop="12"
            textColor="@theme/font/grey" />

        <brls:Box marginTop="14">
            <IconButton
                id="season/download"
                icon="@res/icon/ico-download-light.svg"
                text="@i18n/main/download/season"
                buttonStyle="bordered" />
        </brls:Box>

    </brls:Box>
</brls:Box>
