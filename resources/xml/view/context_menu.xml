<brls:Box
    width="auto"
    height="auto"
    backgroundColor="@theme/brls/backdrop">

    <brls:Box
        id="video/cancel"
        height="100%"
        hideClickAnimation="true"
        grow="1" />

    <!-- side panel anchored to the right: full height, flush with the edge
         (not a floating card — rounding and margins deliberately zero) -->
    <brls:Box
        id="video/context/menu"
        width="400"
        height="100%"
        axis="column"
        paddingTop="24"
        paddingBottom="24"
        paddingLeft="18"
        paddingRight="18"
        backgroundColor="@theme/color/surface"
        alignItems="stretch">

        <brls:Label
            id="menu/title"
            fontSize="21"
            marginLeft="10"
            marginBottom="2" />

        <brls:Label
            id="menu/subtitle"
            fontSize="14"
            marginLeft="10"
            textColor="@theme/font/grey"
            marginBottom="14" />

        <MenuItem
            icon="@res/icon/ico-tv.svg"
            title="@i18n/main/media/go_series"
            visibility="gone"
            id="menu/go/series" />
        <MenuItem
            icon="@res/icon/ico-list.svg"
            title="@i18n/main/media/go_season"
            visibility="gone"
            id="menu/go/season" />
        <MenuItem
            icon="@res/icon/ico-checkmark.svg"
            title="@i18n/main/media/mark_played"
            id="menu/mark/play" />
        <!-- movies/shows with a plex:// guid only; revealed once the
             watchlist state is known (async provider request, context_menu.cpp) -->
        <MenuItem
            icon="@res/icon/ico-bookmark.svg"
            title="@i18n/main/watchlist/add"
            visibility="gone"
            id="menu/watchlist" />
        <MenuItem
            icon="@res/icon/ico-download.svg"
            title="@i18n/main/download/start"
            id="menu/download" />

    </brls:Box>
</brls:Box>
